<div id="stores" class="py-12 bg-white border-b border-[#E6E6E6]">
  <div class="container max-w-6xl">
    
    <div class="text-center max-w-2xl mx-auto space-y-3 mb-10">
      <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold">
        {{ section.settings.eyebrow | default: 'EXPERIENCE CENTRES' }}
      </span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#252525]">
        {{ section.settings.heading | default: 'Libas Stores Across India' }}
      </h1>
      <p class="text-xs sm:text-sm text-[#737373]">
        {{ section.settings.description | default: 'Visit our experiential boutiques in Delhi NCR, Mumbai, Bengaluru, Jaipur, and Hyderabad.' }}
      </p>
    </div>

    <!-- Store Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-14">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="p-6 rounded-2xl bg-[#FAF7F9] border border-[#E6E6E6] space-y-3" {{ block.shopify_attributes }}>
            <span class="text-[10px] font-mono text-[#71006A] font-extrabold uppercase px-2 py-0.5 rounded bg-white border border-[#E6E6E6]">{{ block.settings.city }}</span>
            <h3 class="text-base font-serif font-bold text-[#252525]">{{ block.settings.title }}</h3>
            <p class="text-xs text-[#737373]">{{ block.settings.address }}</p>
            <p class="text-xs text-[#252525] font-semibold">📞 {{ block.settings.phone }}</p>
            <p class="text-xs text-[#737373]">🕒 {{ block.settings.timings }}</p>
          </div>
        {% endfor %}
      {% else %}
        <div class="p-6 rounded-2xl bg-[#FAF7F9] border border-[#E6E6E6] space-y-3">
          <span class="text-[10px] font-mono text-[#71006A] font-extrabold uppercase px-2 py-0.5 rounded bg-white border border-[#E6E6E6]">Delhi NCR</span>
          <h3 class="text-base font-serif font-bold text-[#252525]">South Extension Flagship</h3>
          <p class="text-xs text-[#737373]">E-14, Part-2, Main Market, South Extension, New Delhi - 110049</p>
          <p class="text-xs text-[#252525] font-semibold">📞 +91 11 4105 8822</p>
          <p class="text-xs text-[#737373]">🕒 10:30 AM - 9:00 PM (Daily)</p>
        </div>

        <div class="p-6 rounded-2xl bg-[#FAF7F9] border border-[#E6E6E6] space-y-3">
          <span class="text-[10px] font-mono text-[#71006A] font-extrabold uppercase px-2 py-0.5 rounded bg-white border border-[#E6E6E6]">Mumbai</span>
          <h3 class="text-base font-serif font-bold text-[#252525]">Bandra Experience Centre</h3>
          <p class="text-xs text-[#737373]">Linking Road, Khar Telephone Exchange, Bandra West, Mumbai - 400052</p>
          <p class="text-xs text-[#252525] font-semibold">📞 +91 22 2640 1199</p>
          <p class="text-xs text-[#737373]">🕒 11:00 AM - 9:30 PM (Daily)</p>
        </div>

        <div class="p-6 rounded-2xl bg-[#FAF7F9] border border-[#E6E6E6] space-y-3">
          <span class="text-[10px] font-mono text-[#71006A] font-extrabold uppercase px-2 py-0.5 rounded bg-white border border-[#E6E6E6]">Bengaluru</span>
          <h3 class="text-base font-serif font-bold text-[#252525]">Indiranagar Atelier</h3>
          <p class="text-xs text-[#737373]">100ft Road, HAL 2nd Stage, Indiranagar, Bengaluru - 560038</p>
          <p class="text-xs text-[#252525] font-semibold">📞 +91 80 4112 7744</p>
          <p class="text-xs text-[#737373]">🕒 10:30 AM - 9:00 PM (Daily)</p>
        </div>
      {% endif %}
    </div>

    <!-- Product Showcase -->
    <div class="pt-8 border-t border-[#E6E6E6]">
      <h3 class="text-xl font-serif font-bold text-[#252525] mb-6">{{ section.settings.showcase_heading | default: 'Trending In Stores Now' }}</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        {% assign showcase_col = section.settings.collection %}
        {% if showcase_col != blank and showcase_col.products_count > 0 %}
          {% for product in showcase_col.products limit: 4 %}
            {% render 'product-card', product: product %}
          {% endfor %}
        {% else %}
          {% render 'product-card',
            title: 'Purple Zari Silk Anarkali Suit Set',
            price: '₹3,499',
            original_price: '₹6,999',
            image: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Mustard Georgette Sharara Suit Set',
            price: '₹2,799',
            original_price: '₹5,599',
            image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Wine Chanderi Silk Foil Print Kurta',
            price: '₹1,299',
            original_price: '₹2,599',
            image: 'https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Lavender Pure Organza Floral Saree',
            price: '₹2,899',
            original_price: '₹5,799',
            image: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=600&auto=format&fit=crop'
          %}
        {% endif %}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Stores Directory",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "EXPERIENCE CENTRES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Libas Stores Across India" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Visit our experiential boutiques in Delhi NCR, Mumbai, Bengaluru, Jaipur, and Hyderabad." },
    { "type": "text", "id": "showcase_heading", "label": "Showcase Heading", "default": "Trending In Stores Now" },
    { "type": "collection", "id": "collection", "label": "Showcase Collection" }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store Location",
      "settings": [
        { "type": "text", "id": "city", "label": "City Badge", "default": "Delhi NCR" },
        { "type": "text", "id": "title", "label": "Store Name", "default": "South Extension Flagship" },
        { "type": "textarea", "id": "address", "label": "Address", "default": "E-14, Part-2, Main Market, South Extension, New Delhi - 110049" },
        { "type": "text", "id": "phone", "label": "Phone Number", "default": "+91 11 4105 8822" },
        { "type": "text", "id": "timings", "label": "Timings", "default": "10:30 AM - 9:00 PM (Daily)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stores Directory",
      "blocks": [
        { "type": "store", "settings": { "city": "Delhi NCR", "title": "South Extension Flagship", "address": "E-14, Part-2, Main Market, South Extension, New Delhi - 110049", "phone": "+91 11 4105 8822", "timings": "10:30 AM - 9:00 PM (Daily)" } },
        { "type": "store", "settings": { "city": "Mumbai", "title": "Bandra Experience Centre", "address": "Linking Road, Khar Telephone Exchange, Bandra West, Mumbai - 400052", "phone": "+91 22 2640 1199", "timings": "11:00 AM - 9:30 PM (Daily)" } },
        { "type": "store", "settings": { "city": "Bengaluru", "title": "Indiranagar Atelier", "address": "100ft Road, HAL 2nd Stage, Indiranagar, Bengaluru - 560038", "phone": "+91 80 4112 7744", "timings": "10:30 AM - 9:00 PM (Daily)" } }
      ]
    }
  ]
}
{% endschema %}
