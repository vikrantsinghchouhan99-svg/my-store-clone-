<section id="loungewear" class="py-14 bg-[#FAF7F9] border-b border-[#E6E6E6]">
  <div class="container">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row items-baseline justify-between mb-8 border-b border-[#E6E6E6] pb-4 gap-4">
      <div>
        <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold block">
          {{ section.settings.eyebrow | default: 'CATEGORY • CO-ORDS & LOUNGEWEAR' }}
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#252525] mt-1">
          {{ section.settings.heading | default: 'Comfort Kaftans, Kurta Sets & Loungewear' }}
        </h2>
        <p class="text-xs text-[#737373] mt-1">
          {{ section.settings.description | default: 'Breezy modal kaftans, cotton printed loungewear sets, and relaxed weekend fits.' }}
        </p>
      </div>

      <div class="flex items-center gap-2">
        {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
          <span class="text-xs font-mono font-bold text-[#71006A]">Showing {{ section.settings.collection.products_count }} Products</span>
        {% else %}
          <span class="text-xs font-mono font-bold text-[#71006A]">Showing Lounge Silhouettes</span>
        {% endif %}
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {% assign chosen_col = section.settings.collection %}
      {% if chosen_col != blank and chosen_col.products_count > 0 %}
        {% for product in chosen_col.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% render 'product-card',
        title: 'Printed Silk Blend Kaftan Lounge Set',
        price: '₹1,799',
        original_price: '₹3,599',
        image: 'https://images.unsplash.com/photo-1596783074918-c84cb06531ca?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Pastel Pink Cotton Co-ord Set with Pockets',
        price: '₹1,499',
        original_price: '₹2,999',
        image: 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Emerald Green Festive Satin Kaftan Set',
        price: '₹2,199',
        original_price: '₹4,399',
        image: 'https://images.unsplash.com/photo-1558769132-cb1aea458c5e?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Mustard Yellow Cotton Pyjama Lounge Set',
        price: '₹1,299',
        original_price: '₹2,599',
        image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Navy Blue Blazer Kurti & Trouser Co-ord Set',
        price: '₹2,299',
        original_price: '₹4,599',
        image: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Wine Modal Silk Printed Long Kaftan Set',
        price: '₹1,899',
        original_price: '₹3,799',
        image: 'https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Sage Green Chikankari Cotton Lounge Co-ord',
        price: '₹1,999',
        original_price: '₹3,999',
        image: 'https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Rust Orange Shibori Tie-Dye Co-ord Set',
        price: '₹1,699',
        original_price: '₹3,399',
        image: 'https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?q=80&w=1000&auto=format&fit=crop'
      %}
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Co-ords & Loungewear",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "CATEGORY • CO-ORDS & LOUNGEWEAR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Comfort Kaftans, Kurta Sets & Loungewear"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Breezy modal kaftans, cotton printed loungewear sets, and relaxed weekend fits."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Co-ords & Loungewear"
    }
  ]
}
{% endschema %}
