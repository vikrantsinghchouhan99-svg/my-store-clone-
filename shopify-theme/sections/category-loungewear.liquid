<section id="loungewear" class="py-14 bg-white border-b border-[#E6E6E6]">
  <div class="container">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row items-baseline justify-between mb-8 border-b border-[#E6E6E6] pb-4 gap-4">
      <div>
        <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold block">
          CATEGORY • CO-ORDS & LOUNGEWEAR
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#252525] mt-1">
          Pure Cotton Coordinate Sets & Silk Kaftans
        </h2>
        <p class="text-xs text-[#737373] mt-1">
          Effortless silhouettes created for celebration dinners, airport travel, and relaxed festive hosting.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a href="{{ routes.all_products_collection_url }}?filter=loungewear" class="text-xs font-bold text-[#71006A] hover:underline flex items-center gap-1">
          <span>View All Loungewear</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {% render 'product-card',
        title: 'Berry Plum Geometric Printed Pure Cotton Co-ord Set',
        price: '₹1,699',
        original_price: '₹3,399',
        image: 'https://images.unsplash.com/photo-1596783074918-c84cb06531ca?q=80&w=600&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Lilac Floral Silk Blend Kaftan Lounge Set',
        price: '₹1,899',
        original_price: '₹3,799',
        image: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Sage Green Ikat Print Cotton Co-ord Set',
        price: '₹1,599',
        original_price: '₹3,199',
        image: 'https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?q=80&w=600&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Dusty Rose Embroidered Kaftan Kurta Set',
        price: '₹1,799',
        original_price: '₹3,599',
        image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=600&auto=format&fit=crop'
      %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Loungewear Showcase",
  "settings": []
}
{% endschema %}
