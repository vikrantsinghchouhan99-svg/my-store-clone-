<div class="announcement-bar py-2 px-4 text-center text-xs font-semibold tracking-wider uppercase" style="background-color: {{ section.settings.bg_color | default: '#71006A' }}; color: {{ section.settings.text_color | default: '#FFFFFF' }};">
  <div class="container flex items-center justify-center gap-2">
    <span>✨</span>
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="hover:underline" style="color: {{ section.settings.text_color | default: '#FFFFFF' }};">
        {{ section.settings.announcement_text | default: 'THE FESTIVE EDIT 2026 • USE CODE PREPAID10 FOR EXTRA 10% OFF' }}
      </a>
    {% else %}
      <span>{{ section.settings.announcement_text | default: 'THE FESTIVE EDIT 2026 • USE CODE PREPAID10 FOR EXTRA 10% OFF' }}</span>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "THE FESTIVE EDIT 2026 • USE CODE PREPAID10 FOR EXTRA 10% OFF"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#71006A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
