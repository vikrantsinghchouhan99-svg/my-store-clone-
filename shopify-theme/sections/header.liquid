<header class="site-header sticky top-0 z-40 bg-white border-b border-[#E6E6E6]">
  <div class="container py-3 sm:py-4">
    <div class="flex items-center justify-between gap-4">
      
      <!-- Brand Logo & Mobile Toggle -->
      <div class="flex items-center gap-2 sm:gap-6">
        <button
          type="button"
          class="mobile-menu-btn lg:hidden p-1.5 -ml-1 text-[#252525] hover:text-[#71006A] bg-transparent border-none cursor-pointer"
          data-mobile-menu-toggle
          aria-label="Open mobile menu"
        >
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <a href="{{ routes.root_url }}" class="brand-font text-2xl sm:text-3xl font-extrabold tracking-widest text-[#71006A]">
          LIBAS
        </a>
      </div>

      <!-- Search Bar -->
      <div class="header-search-bar hidden md:flex flex-1 max-w-md mx-6 relative" data-search-container="desktop">
        <form action="{{ routes.search_url }}" method="get" class="w-full relative" data-search-form="desktop">
          <input
            type="search"
            name="q"
            autocomplete="off"
            placeholder="Search Suits, Kurtas, Sarees, Dresses..."
            class="header-search-input w-full pl-10 pr-8 py-2 text-xs bg-[#FAF7F9] border border-[#E6E6E6] rounded-full outline-none focus:border-[#71006A] transition-colors"
            data-search-input="desktop"
          >
          <button type="submit" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[#737373] hover:text-[#71006A] bg-transparent border-none cursor-pointer" aria-label="Submit search">
            {% render 'icon-search' %}
          </button>
          <button type="button" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-xs text-[#737373] hover:text-[#252525] bg-transparent border-none cursor-pointer" data-search-clear="desktop" aria-label="Clear search">✕</button>
        </form>
        <!-- Predictive Search Dropdown -->
        <div class="predictive-search-dropdown hidden absolute left-0 right-0 top-full mt-2 w-full" data-search-dropdown="desktop"></div>
      </div>

      <!-- Actions: Account, Wishlist, Bag -->
      <div class="flex items-center gap-4 sm:gap-6 text-[#252525]">
        <!-- Currency -->
        <span class="currency-badge hidden sm:inline-block text-xs font-mono font-bold text-[#71006A] px-2 py-0.5 rounded bg-[#FAF7F9] border border-[#E6E6E6]">
          ₹ INR
        </span>

        <!-- Account -->
        <button
          type="button"
          data-auth-trigger
          class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider hover:text-[#71006A] transition-colors bg-transparent border-none cursor-pointer"
        >
          {% render 'icon-user' %}
          <span class="hidden lg:inline">Sign In</span>
        </button>

        <!-- Wishlist -->
        <a
          href="/pages/wishlist"
          class="hover:text-[#71006A] transition-colors flex items-center gap-1"
          title="Wishlist"
        >
          {% render 'icon-heart' %}
        </a>

        <!-- Cart Bag -->
        <button
          type="button"
          data-cart-drawer-trigger
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#71006A] text-white hover:bg-[#560050] transition-colors text-xs font-bold border-none cursor-pointer"
        >
          {% render 'icon-cart' %}
          <span class="hidden sm:inline">Bag</span>
          <span class="bg-white text-[#71006A] w-4 h-4 rounded-full text-[10px] font-bold flex items-center justify-center ml-1">
            {{ cart.item_count | default: 0 }}
          </span>
        </button>
      </div>
    </div>

    <!-- Mega Menu Navigation Links -->
    <nav class="site-nav hidden lg:flex items-center justify-center gap-1 pt-2 border-t border-[#F5F5F5] mt-2 text-xs font-bold tracking-wider uppercase">
      
      <!-- Suits Dropdown -->
      <div class="has-dropdown py-2 px-3 hover:text-[#71006A] cursor-pointer">
        <a href="/collections/suits">Suits & Sets ▾</a>
        <div class="dropdown-menu">
          <div>
            <h5 class="text-[10px] font-mono text-[#71006A] uppercase mb-2 font-bold">By Silhouette</h5>
            <ul class="space-y-1.5 text-xs text-[#737373] font-normal normal-case" style="list-style: none;">
              <li><a href="/collections/suits?style=Anarkali" class="hover:text-[#71006A]">Anarkali Suits</a></li>
              <li><a href="/collections/suits?style=Sharara" class="hover:text-[#71006A]">Sharara & Gharara Sets</a></li>
              <li><a href="/collections/suits?style=Palazzo" class="hover:text-[#71006A]">Palazzo Suit Sets</a></li>
              <li><a href="/collections/suits?style=Straight" class="hover:text-[#71006A]">Straight Cut Suits</a></li>
            </ul>
          </div>
          <div>
            <h5 class="text-[10px] font-mono text-[#71006A] uppercase mb-2 font-bold">By Occasion</h5>
            <ul class="space-y-1.5 text-xs text-[#737373] font-normal normal-case" style="list-style: none;">
              <li><a href="/collections/suits?occasion=Wedding" class="hover:text-[#71006A]">Wedding Celebrations</a></li>
              <li><a href="/collections/suits?occasion=Festive" class="hover:text-[#71006A]">Festive Parties</a></li>
              <li><a href="/collections/suits?occasion=Daily" class="hover:text-[#71006A]">Daily Casual Cotton</a></li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Kurtas Dropdown -->
      <div class="has-dropdown py-2 px-3 hover:text-[#71006A] cursor-pointer">
        <a href="/collections/kurtas">Kurtas & Kurtis ▾</a>
        <div class="dropdown-menu">
          <div>
            <h5 class="text-[10px] font-mono text-[#71006A] uppercase mb-2 font-bold">By Silhouette</h5>
            <ul class="space-y-1.5 text-xs text-[#737373] font-normal normal-case" style="list-style: none;">
              <li><a href="/collections/kurtas?style=Straight" class="hover:text-[#71006A]">Straight Cut Kurtas</a></li>
              <li><a href="/collections/kurtas?style=A-Line" class="hover:text-[#71006A]">A-Line & Flared</a></li>
              <li><a href="/collections/kurtas?style=Short" class="hover:text-[#71006A]">Short Tunic Kurtis</a></li>
            </ul>
          </div>
          <div>
            <h5 class="text-[10px] font-mono text-[#71006A] uppercase mb-2 font-bold">Craft & Print</h5>
            <ul class="space-y-1.5 text-xs text-[#737373] font-normal normal-case" style="list-style: none;">
              <li><a href="/collections/kurtas?fabric=Silk" class="hover:text-[#71006A]">Zari & Foil Work</a></li>
              <li><a href="/collections/kurtas?fabric=Cotton" class="hover:text-[#71006A]">Ajrakh & Block Prints</a></li>
              <li><a href="/collections/kurtas?occasion=Daily" class="hover:text-[#71006A]">Chikankari Threadwork</a></li>
            </ul>
          </div>
        </div>
      </div>

      <a href="/collections/sarees" class="py-2 px-3 hover:text-[#71006A]">Sarees</a>
      <a href="/collections/dresses" class="py-2 px-3 hover:text-[#71006A]">Dresses</a>
      <a href="/collections/loungewear" class="py-2 px-3 hover:text-[#71006A]">Co-ords & Lounge</a>
      
      <!-- Plus Size -->
      <a href="/collections/plus-size" class="py-2 px-3 text-[#71006A] font-extrabold hover:text-[#560050]">
        ExtraLove (3XL-6XL)
      </a>

      <!-- Sale -->
      <a href="/collections/sale" class="py-2 px-3 text-[#D92D20] font-extrabold hover:underline">
        Festive Sale
      </a>
    </nav>
  </div>

  <!-- Mobile Slide-Out Navigation Drawer -->
  <div id="MobileNavDrawer" class="mobile-nav-drawer" aria-hidden="true">
    <div class="mobile-nav-backdrop" data-mobile-menu-close></div>
    <div class="mobile-nav-content">
      <div class="flex items-center justify-between p-4 border-b border-[#E6E6E6] bg-[#FAF7F9]">
        <a href="{{ routes.root_url }}" class="brand-font text-2xl font-black tracking-widest text-[#71006A]">LIBAS</a>
        <button type="button" class="p-1 text-[#737373] hover:text-[#252525] bg-transparent border-none cursor-pointer" data-mobile-menu-close aria-label="Close menu">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Search Form -->
      <div class="p-3 border-b border-[#E6E6E6] relative" data-search-container="mobile">
        <form action="{{ routes.search_url }}" method="get" class="relative" data-search-form="mobile">
          <input
            type="search"
            name="q"
            autocomplete="off"
            placeholder="Search Suits, Kurtas, Sarees..."
            class="w-full pl-9 pr-8 py-2 text-xs bg-[#FAF7F9] border border-[#E6E6E6] rounded-full outline-none focus:border-[#71006A]"
            data-search-input="mobile"
          >
          <svg class="w-4 h-4 text-[#71006A] absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
          <button type="button" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-xs text-[#737373] hover:text-[#252525] bg-transparent border-none cursor-pointer" data-search-clear="mobile" aria-label="Clear search">✕</button>
        </form>
        <!-- Mobile Dropdown -->
        <div class="predictive-search-dropdown hidden mt-2 w-full" data-search-dropdown="mobile"></div>
      </div>

      <!-- Mobile Category Navigation Links -->
      <div class="p-4 space-y-1 flex-1 overflow-y-auto">
        <div class="pb-2 text-[10px] font-mono font-extrabold uppercase tracking-widest text-[#71006A]">COLLECTIONS</div>
        
        <div class="border-b border-[#F5F5F5] py-2">
          <a href="/collections/suits" class="flex items-center justify-between font-bold text-sm text-[#252525] hover:text-[#71006A]">
            <span>👗 Suits & Sets</span>
            <span class="text-[10px] text-[#71006A] font-mono">From ₹1,899</span>
          </a>
        </div>

        <div class="border-b border-[#F5F5F5] py-2">
          <a href="/collections/kurtas" class="flex items-center justify-between font-bold text-sm text-[#252525] hover:text-[#71006A]">
            <span>👚 Kurtas & Kurtis</span>
            <span class="text-[10px] text-[#71006A] font-mono">From ₹899</span>
          </a>
        </div>

        <div class="border-b border-[#F5F5F5] py-2">
          <a href="/collections/sarees" class="flex items-center justify-between font-bold text-sm text-[#252525] hover:text-[#71006A]">
            <span>🥻 Sarees</span>
            <span class="text-[10px] text-[#71006A] font-mono">From ₹2,199</span>
          </a>
        </div>

        <div class="border-b border-[#F5F5F5] py-2">
          <a href="/collections/dresses" class="flex items-center justify-between font-bold text-sm text-[#252525] hover:text-[#71006A]">
            <span>💃 Ethnic Dresses</span>
            <span class="text-[10px] text-[#71006A] font-mono">From ₹1,699</span>
          </a>
        </div>

        <div class="border-b border-[#F5F5F5] py-2">
          <a href="/collections/loungewear" class="flex items-center justify-between font-bold text-sm text-[#252525] hover:text-[#71006A]">
            <span>👘 Co-ords & Lounge</span>
            <span class="text-[10px] text-[#71006A] font-mono">From ₹1,299</span>
          </a>
        </div>

        <div class="border-b border-[#F5F5F5] py-2">
          <a href="/collections/plus-size" class="flex items-center justify-between font-extrabold text-sm text-[#71006A]">
            <span>✨ ExtraLove (3XL-6XL)</span>
            <span class="px-2 py-0.5 rounded-full text-[9px] bg-[#71006A]/10 text-[#71006A]">CURVE</span>
          </a>
        </div>

        <div class="border-b border-[#F5F5F5] py-2">
          <a href="/collections/sale" class="flex items-center justify-between font-extrabold text-sm text-[#D92D20]">
            <span>🔥 Festive Sale</span>
            <span class="px-2 py-0.5 rounded-full text-[9px] bg-red-100 text-[#D92D20]">UP TO 60%</span>
          </a>
        </div>

        <div class="pt-4 pb-2 text-[10px] font-mono font-extrabold uppercase tracking-widest text-[#71006A]">CUSTOMER CARE</div>

        <div class="space-y-2 text-xs font-medium text-[#4D4D4D]">
          <a href="/pages/track-order" class="flex items-center gap-2 py-1.5 hover:text-[#71006A]">
            <span>📦</span>
            <span>Track My Order</span>
          </a>
          <a href="/pages/returns" class="flex items-center gap-2 py-1.5 hover:text-[#71006A]">
            <span>🔄</span>
            <span>15-Day Easy Returns</span>
          </a>
          <a href="/pages/shipping-policy" class="flex items-center gap-2 py-1.5 hover:text-[#71006A]">
            <span>🚚</span>
            <span>Shipping & Delivery SLA</span>
          </a>
          <a href="/pages/stores" class="flex items-center gap-2 py-1.5 hover:text-[#71006A]">
            <span>📍</span>
            <span>Flagship Boutiques</span>
          </a>
          <a href="/pages/about" class="flex items-center gap-2 py-1.5 hover:text-[#71006A]">
            <span>📖</span>
            <span>About Libas & Craft</span>
          </a>
          <a href="/pages/contact" class="flex items-center gap-2 py-1.5 hover:text-[#71006A]">
            <span>📞</span>
            <span>Contact Us & FAQs</span>
          </a>
        </div>
      </div>

      <!-- Mobile Drawer Footer -->
      <div class="p-4 border-t border-[#E6E6E6] bg-[#FAF7F9] space-y-2 text-xs">
        <div class="flex items-center justify-between font-bold">
          <span>Currency</span>
          <span class="font-mono text-[#71006A]">₹ INR</span>
        </div>
        <div class="text-[11px] text-[#737373]">
          Helpline: <a href="tel:+919899990772" class="text-[#71006A] font-bold">+91 98999 90772</a>
        </div>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
