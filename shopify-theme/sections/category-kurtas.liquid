<section id="kurtas" class="py-14 bg-[#FAF7F9] border-b border-[#E6E6E6]">
  <div class="container">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row items-baseline justify-between mb-8 border-b border-[#E6E6E6] pb-4 gap-4">
      <div>
        <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold block">
          {{ section.settings.eyebrow | default: 'CATEGORY • KURTAS & KURTIS' }}
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#252525] mt-1">
          {{ section.settings.heading | default: 'Artisan Kurtas & Daily Tunics' }}
        </h2>
        <p class="text-xs text-[#737373] mt-1">
          {{ section.settings.description | default: 'Hand block prints, woven Chanderi silks, and breathable everyday cotton kurtis.' }}
        </p>
      </div>

      <div class="flex items-center gap-2">
        {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
          <span class="text-xs font-mono font-bold text-[#71006A]">Showing {{ section.settings.collection.products_count }} Products</span>
        {% else %}
          <span class="text-xs font-mono font-bold text-[#71006A]">Showing Daily & Festive Kurtas</span>
        {% endif %}
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {% assign chosen_col = section.settings.collection %}
      {% if chosen_col != blank and chosen_col.products_count > 0 %}
        {% for product in chosen_col.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% render 'product-card',
        title: 'Wine Chanderi Silk Foil Print Straight Kurta',
        price: '₹1,299',
        original_price: '₹2,599',
        image: 'https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Indigo Blue Ajrakh Handblock Pure Cotton Kurta',
        price: '₹1,099',
        original_price: '₹2,199',
        image: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Peach Embroidered Cotton Peplum Tunic Kurti',
        price: '₹899',
        original_price: '₹1,799',
        image: 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Teal Green Woven Yoke Cotton Straight Kurta',
        price: '₹1,199',
        original_price: '₹2,399',
        image: 'https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Yellow Floral Printed Flared A-Line Kurti',
        price: '₹999',
        original_price: '₹1,999',
        image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Lavender Woven Chanderi Festive Kurti',
        price: '₹1,399',
        original_price: '₹2,799',
        image: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Ruby Red Chikankari Embroidered Long Kurta',
        price: '₹1,499',
        original_price: '₹2,999',
        image: 'https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Olive Green Cotton Slub Daily Tunic Kurti',
        price: '₹849',
        original_price: '₹1,699',
        image: 'https://images.unsplash.com/photo-1558769132-cb1aea458c5e?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Black & Gold Festive Angrakha Flared Kurta',
        price: '₹1,399',
        original_price: '₹2,799',
        image: 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1000&auto=format&fit=crop'
      %}
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Kurtas & Kurtis",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "CATEGORY • KURTAS & KURTIS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Artisan Kurtas & Daily Tunics"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Hand block prints, woven Chanderi silks, and breathable everyday cotton kurtis."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Kurtas & Kurtis"
    }
  ]
}
{% endschema %}
