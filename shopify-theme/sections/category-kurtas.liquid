<section id="kurtas" class="py-14 bg-[#FAF7F9] border-b border-[#E6E6E6]">
  <div class="container">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row items-baseline justify-between mb-8 border-b border-[#E6E6E6] pb-4 gap-4">
      <div>
        <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold block">
          CATEGORY • KURTAS & KURTIS
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#252525] mt-1">
          Chikankari, Ajrakh & Straight Tunics
        </h2>
        <p class="text-xs text-[#737373] mt-1">
          Hand-embroidered threadwork, authentic wooden block prints, and breezy festive silhouettes.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a href="{{ routes.all_products_collection_url }}?filter=kurtas" class="text-xs font-bold text-[#71006A] hover:underline flex items-center gap-1">
          <span>View All Kurtas</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {% render 'product-card',
        title: 'Wine Chanderi Silk Foil Print Straight Kurta',
        price: '₹1,299',
        original_price: '₹2,599',
        image: 'https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?q=80&w=600&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Indigo Blue Ajrakh Block Printed A-Line Kurta',
        price: '₹999',
        original_price: '₹1,999',
        image: 'https://images.unsplash.com/photo-1609357605129-26f69add5d6e?q=80&w=600&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Peach Thread Embroidered Tunic Short Kurti',
        price: '₹899',
        original_price: '₹1,799',
        image: 'https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?q=80&w=600&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Blush Pink Cotton Straight Kurta',
        price: '₹1,199',
        original_price: '₹2,399',
        image: 'https://images.unsplash.com/photo-1596783074918-c84cb06531ca?q=80&w=600&auto=format&fit=crop'
      %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Kurtas Showcase",
  "settings": []
}
{% endschema %}
