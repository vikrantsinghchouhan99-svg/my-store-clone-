<!-- Customer Stories & Social Proof Section -->
<section class="py-14 bg-white">
  <div class="container max-w-7xl">
    <div class="text-center max-w-xl mx-auto mb-10 space-y-1.5">
      <div class="flex items-center justify-center gap-1 text-amber-500 mb-1">
        <span class="text-amber-500 text-base">★★★★★</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#252525]">
        Loved by Over 10 Million Women
      </h2>
      <p class="text-xs text-[#737373]">
        Discover why Libas is India's most cherished ethnic and fusion destination.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Review 1 -->
      <div class="p-6 rounded-2xl bg-[#FAF7F9] border border-[#E6E6E6] space-y-3">
        <div class="text-amber-500 text-sm">★★★★★</div>
        <h3 class="font-bold text-sm text-[#252525] font-serif">
          &ldquo;Wore the Anarkali to my sister's Sangeet&rdquo;
        </h3>
        <p class="text-xs text-[#4D4D4D] leading-relaxed">
          The rich plum tone and gold zari work were stunning in photos. The Chanderi silk is so lightweight yet feels regal. Received countless compliments all night!
        </p>
        <div class="pt-2 border-t border-[#E6E6E6] flex items-center justify-between text-[11px]">
          <span class="font-bold text-[#252525] flex items-center gap-1">
            Ananya Sengupta <span class="text-emerald-700 font-bold">✓</span>
          </span>
          <span class="text-[#999999] font-mono">Kolkata</span>
        </div>
      </div>

      <!-- Review 2 -->
      <div class="p-6 rounded-2xl bg-[#FAF7F9] border border-[#E6E6E6] space-y-3">
        <div class="text-amber-500 text-sm">★★★★★</div>
        <h3 class="font-bold text-sm text-[#252525] font-serif">
          &ldquo;ExtraLove 4XL fit is an absolute dream!&rdquo;
        </h3>
        <p class="text-xs text-[#4D4D4D] leading-relaxed">
          Finding plus-size ethnic wear that looks festive and doesn't feel tight around the arms was impossible until I found Libas. Beautiful cut and true to size!
        </p>
        <div class="pt-2 border-t border-[#E6E6E6] flex items-center justify-between text-[11px]">
          <span class="font-bold text-[#252525] flex items-center gap-1">
            Ritika Oberoi <span class="text-emerald-700 font-bold">✓</span>
          </span>
          <span class="text-[#999999] font-mono">New Delhi</span>
        </div>
      </div>

      <!-- Review 3 -->
      <div class="p-6 rounded-2xl bg-[#FAF7F9] border border-[#E6E6E6] space-y-3">
        <div class="text-amber-500 text-sm">★★★★★</div>
        <h3 class="font-bold text-sm text-[#252525] font-serif">
          &ldquo;Organza Saree delivered in 48 hours&rdquo;
        </h3>
        <p class="text-xs text-[#4D4D4D] leading-relaxed">
          Super fast delivery and packaging was premium. The organza has the right amount of stiffness to hold pleats, and the scalloped border is exquisite.
        </p>
        <div class="pt-2 border-t border-[#E6E6E6] flex items-center justify-between text-[11px]">
          <span class="font-bold text-[#252525] flex items-center gap-1">
            Dr. Meenakshi Iyer <span class="text-emerald-700 font-bold">✓</span>
          </span>
          <span class="text-[#999999] font-mono">Bengaluru</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Testimonials",
  "settings": []
}
{% endschema %}