<section class="relative overflow-hidden bg-[#FAF7F9] border-b border-[#E6E6E6] py-12 lg:py-16">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Content -->
      <div class="lg:col-span-7 space-y-5 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#71006A]/10 text-[#71006A] text-xs font-bold tracking-wider uppercase">
          <span>✨</span>
          <span>{{ section.settings.subheading | default: 'THE FESTIVE EDIT 2026 • UP TO 60% OFF' }}</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-serif font-bold text-[#252525] leading-tight">
          {{ section.settings.heading | default: 'Grace in Every Thread.' }} <br>
          <span class="italic font-light text-[#71006A]">Timeless Festive Grandeur.</span>
        </h1>

        <p class="text-xs sm:text-sm text-[#4D4D4D] max-w-xl mx-auto lg:mx-0 leading-relaxed">
          {{ section.settings.description | default: 'Discover exquisitely tailored Anarkalis, Sharara sets, sheer silk organza sarees, and breathable pure cotton kurtas crafted for celebratory moments.' }}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
          <a href="{{ section.settings.primary_btn_link | default: '/collections/all?filter=suits' }}" class="btn-primary w-full sm:w-auto">
            <span>Shop Festive Suits</span>
            <span>→</span>
          </a>
          <a href="{{ routes.all_products_collection_url }}?filter=sarees" class="btn-outline w-full sm:w-auto">
            Explore Sarees
          </a>
          <a href="{{ routes.all_products_collection_url }}?filter=sale" class="btn-primary w-full sm:w-auto bg-[#FF8C91] text-[#71006A] hover:bg-[#ff7a80]">
            Flat 50% Off
          </a>
        </div>

        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-[#E6E6E6] max-w-md mx-auto lg:mx-0">
          <div>
            <p class="text-2xl font-serif font-bold text-[#71006A]">10M+</p>
            <p class="text-[11px] text-[#737373]">Satisfied Customers</p>
          </div>
          <div>
            <p class="text-2xl font-serif font-bold text-[#71006A]">XS - 6XL</p>
            <p class="text-[11px] text-[#737373]">Inclusive Fit For All</p>
          </div>
          <div>
            <p class="text-2xl font-serif font-bold text-[#71006A]">100%</p>
            <p class="text-[11px] text-[#737373]">Pure Ethnic Craft</p>
          </div>
        </div>
      </div>

      <!-- Right Visual -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-sm sm:max-w-md">
          <div class="rounded-2xl overflow-hidden shadow-2xl border-2 border-white aspect-[3/4] bg-[#F5F5F5]">
            <img
              src="{{ section.settings.hero_image | default: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=1000&auto=format&fit=crop' }}"
              alt="Libas Festive Anarkali"
              width="1000"
              height="1333"
              class="w-full h-full object-cover object-top"
              onerror="this.src='https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=1000&auto=format&fit=crop';"
            >
          </div>

          <!-- Spotlight Badge -->
          <div class="absolute -bottom-5 -left-5 bg-white p-3.5 rounded-xl border border-[#E6E6E6] shadow-xl max-w-[210px] hidden sm:block">
            <span class="text-[9px] font-mono uppercase tracking-widest text-[#71006A] font-extrabold">
              Trending Pick
            </span>
            <p class="text-xs font-bold text-[#252525] line-clamp-1 mt-0.5">
              Purple Silk Anarkali Set
            </p>
            <div class="flex items-baseline gap-2 mt-1">
              <span class="text-xs font-bold text-[#71006A]">₹3,499</span>
              <span class="text-[10px] text-[#999999] line-through">₹6,999</span>
              <span class="text-[10px] text-emerald-700 font-bold">50% OFF</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading Pill",
      "default": "THE FESTIVE EDIT 2026 • UP TO 60% OFF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Grace in Every Thread."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover exquisitely tailored Anarkalis, Sharara sets, sheer silk organza sarees, and breathable pure cotton kurtas crafted for celebratory moments."
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary Button Link",
      "default": "/collections/suits"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
