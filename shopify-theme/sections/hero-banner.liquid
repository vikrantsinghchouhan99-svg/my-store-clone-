      "id": "hero_image",
      "label": "Hero Showcase Image"
    },
    {
      "type": "header",
      "content": "Action Buttons"
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Primary Button Text",
      "default": "Shop Festive Suits"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Primary Button Link",
      "default": "/collections/suits"
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Secondary Button Text",
      "default": "Explore Sarees"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Secondary Button Link",
      "default": "/collections/sarees"
    },
    {
      "type": "text",
      "id": "btn_3_text",
      "label": "Sale Button Text",
      "default": "Flat 50% Off"
    },
    {
      "type": "url",
      "id": "btn_3_link",
      "label": "Sale Button Link",
      "default": "/collections/sale"
    },
    {
      "type": "header",
      "content": "Spotlight Floating Badge"
    },
    {
      "type": "text",
      "id": "spotlight_badge",
      "label": "Badge Label",
      "default": "Trending Pick"
    },
    {
      "type": "text",
      "id": "spotlight_title",
      "label": "Product Name",
      "default": "Purple Silk Anarkali Set"
    },
    {
      "type": "text",
      "id": "spotlight_price",
      "label": "Discounted Price",
      "default": "₹3,499"
    },
    {
      "type": "text",
      "id": "spotlight_orig_price",
      "label": "Original Price",
      "default": "₹6,999"
    },
    {
      "type": "text",
      "id": "spotlight_discount",
      "label": "Discount Text",
      "default": "50% OFF"
    },
    {
      "type": "header",
      "content": "Trust Stats"
    },
    {
      "type": "text",
      "id": "stat_1_num",
      "label": "Stat 1 Number",
      "default": "10M+"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "Satisfied Customers"
    },
    {
      "type": "text",
      "id": "stat_2_num",
      "label": "Stat 2 Number",
      "default": "XS - 6XL"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Inclusive Fit For All"
    },
    {
      "type": "text",
      "id": "stat_3_num",
      "label": "Stat 3 Number",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "Pure Ethnic Craft"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
