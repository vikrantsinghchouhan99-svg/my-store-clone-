<section id="suits" class="py-14 bg-white border-b border-[#E6E6E6]">
  <div class="container">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row items-baseline justify-between mb-8 border-b border-[#E6E6E6] pb-4 gap-4">
      <div>
        <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold block">
          CATEGORY • SUITS & SETS
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#252525] mt-1">
          Anarkali, Sharara & Palazzo Suit Sets
        </h2>
        <p class="text-xs text-[#737373] mt-1">
          From magnificent wedding Anarkalis to breathable everyday cotton palazzos, explore our hallmark festive suit sets.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-xs font-mono font-bold text-[#71006A]">Showing 10 Hallmark Ensembles</span>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {% render 'product-card',
        title: 'Purple Zari Embroidered Silk Anarkali Suit Set',
        price: '₹3,499',
        original_price: '₹6,999',
        image: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Mustard Gotta Patti Georgette Sharara Suit Set',
        price: '₹2,799',
        original_price: '₹5,599',
        image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Blush Floral Pure Cotton Straight Kurta & Palazzo Set',
        price: '₹1,899',
        original_price: '₹3,799',
        image: 'https://images.unsplash.com/photo-1596783074918-c84cb06531ca?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Emerald Green Embroidered Velvet Suit Set',
        price: '₹4,499',
        original_price: '₹8,999',
        image: 'https://images.unsplash.com/photo-1558769132-cb1aea458c5e?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Wine Chanderi Silk Foil Print Anarkali Set',
        price: '₹3,199',
        original_price: '₹6,399',
        image: 'https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Navy Blue Woven Yoke Straight Kurta Suit',
        price: '₹2,499',
        original_price: '₹4,999',
        image: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Rust Georgette Flared Sharara Set with Dupatta',
        price: '₹2,699',
        original_price: '₹5,399',
        image: 'https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Maroon Festive Silk Blend Anarkali Set',
        price: '₹3,799',
        original_price: '₹7,599',
        image: 'https://images.unsplash.com/photo-1608256246200-53e635b5b65f?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Pistachio Green Lucknowi Chikankari Suit Set',
        price: '₹2,299',
        original_price: '₹4,599',
        image: 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Royal Peacock Teal Velvet Embroidered Suit',
        price: '₹4,299',
        original_price: '₹8,599',
        image: 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1000&auto=format&fit=crop'
      %}
    </div>
  </div>
</section>

