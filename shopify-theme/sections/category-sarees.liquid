<section id="sarees" class="py-14 bg-white border-b border-[#E6E6E6]">
  <div class="container">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row items-baseline justify-between mb-8 border-b border-[#E6E6E6] pb-4 gap-4">
      <div>
        <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold block">
          CATEGORY • SAREES
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#252525] mt-1">
          Designer Sarees & 1-Minute Drapes
        </h2>
        <p class="text-xs text-[#737373] mt-1">
          Sheer tissue organza, pre-pleated ready-to-wear, and heirloom Banarasi zari weaves.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-xs font-mono font-bold text-[#71006A]">Showing 9 Curated Drapes</span>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {% render 'product-card',
        title: 'Burgundy Zari Woven Sheer Organza Saree',
        price: '₹2,699',
        original_price: '₹5,399',
        image: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: '1-Minute Ready-to-Wear Pleated Georgette Saree',
        price: '₹2,199',
        original_price: '₹4,399',
        image: 'https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Royal Banarasi Kathan Silk Zari Saree',
        price: '₹3,999',
        original_price: '₹7,999',
        image: 'https://images.unsplash.com/photo-1608256246200-53e635b5b65f?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Pastel Mint Floral Printed Sheer Chiffon Saree',
        price: '₹1,899',
        original_price: '₹3,799',
        image: 'https://images.unsplash.com/photo-1596783074918-c84cb06531ca?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Royal Blue Zari Woven Kanjivaram Silk Saree',
        price: '₹4,299',
        original_price: '₹8,599',
        image: 'https://images.unsplash.com/photo-1558769132-cb1aea458c5e?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Mustard Yellow Organza Mirror Work Saree',
        price: '₹2,899',
        original_price: '₹5,799',
        image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Midnight Black Tiered Ruffle Cocktail Saree',
        price: '₹2,499',
        original_price: '₹4,999',
        image: 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Blush Pink Luminous Tissue Silk Saree',
        price: '₹2,999',
        original_price: '₹5,999',
        image: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=1000&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Indigo Chanderi Cotton Handblock Print Saree',
        price: '₹1,499',
        original_price: '₹2,999',
        image: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=1000&auto=format&fit=crop'
      %}
    </div>
  </div>
</section>

