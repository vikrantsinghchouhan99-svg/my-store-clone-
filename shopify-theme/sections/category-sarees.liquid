<section id="sarees" class="py-14 bg-white border-b border-[#E6E6E6]">
  <div class="container">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row items-baseline justify-between mb-8 border-b border-[#E6E6E6] pb-4 gap-4">
      <div>
        <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold block">
          CATEGORY • DESIGNER SAREES
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#252525] mt-1">
          Sheer Silk Organza & Pre-Draped Sarees
        </h2>
        <p class="text-xs text-[#737373] mt-1">
          Breathtaking sheer silk organza, pre-draped 1-minute georgette sarees, and zari woven festive drapes.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a href="{{ routes.all_products_collection_url }}?filter=sarees" class="text-xs font-bold text-[#71006A] hover:underline flex items-center gap-1">
          <span>View All Sarees</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {% render 'product-card',
        title: 'Burgundy Zari Woven Sheer Organza Saree',
        price: '₹2,699',
        original_price: '₹5,399',
        image: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=600&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Mauve Pink Pre-Draped 1-Minute Georgette Saree',
        price: '₹2,199',
        original_price: '₹4,399',
        image: 'https://images.unsplash.com/photo-1608256246200-53e635b5b65f?q=80&w=600&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Lavender Pure Organza Floral Zari Saree',
        price: '₹2,899',
        original_price: '₹5,799',
        image: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop'
      %}
      {% render 'product-card',
        title: 'Royal Plum Zari Brocade Wedding Saree',
        price: '₹3,299',
        original_price: '₹6,599',
        image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=600&auto=format&fit=crop'
      %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Sarees Showcase",
  "settings": []
}
{% endschema %}
