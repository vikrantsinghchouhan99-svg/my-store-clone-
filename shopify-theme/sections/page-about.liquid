<div class="py-12 bg-white">
  <div class="container max-w-5xl">
    
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-14">
      <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold">
        THE ATELIER & CRAFT HERITAGE
      </span>
      <h1 class="text-3xl sm:text-5xl font-serif font-bold text-[#252525] leading-tight">
        Crafting Contemporary Indian Elegance
      </h1>
      <p class="text-xs sm:text-sm text-[#737373] leading-relaxed">
        Born from a deep reverence for India&apos;s rich handloom traditions, Libas bridges ancestral textile heritage with fresh, effortless silhouettes designed for modern women across the globe.
      </p>
    </div>

    <!-- Visual Story Banner -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-16 items-center">
      <div class="md:col-span-7 rounded-2xl overflow-hidden aspect-[16/10] bg-[#F5F5F5] shadow-lg">
        <img
          src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=1000&auto=format&fit=crop"
          alt="Artisan Craftsmanship"
          class="w-full h-full object-cover object-top"
        >
      </div>
      <div class="md:col-span-5 space-y-4">
        <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-bold">SINCE 1993</span>
        <h2 class="text-2xl font-serif font-bold text-[#252525]">Every Stitch Tells An Unhurried Story</h2>
        <p class="text-xs text-[#4D4D4D] leading-relaxed">
          We collaborate with over 2,500 master artisans across Jaipur, Chanderi, Lucknow, and Varanasi. Every motif, gota patti accent, and wooden block print is rendered with meticulous precision, honouring slow fashion and ethical artisan communities.
        </p>
      </div>
    </div>

    <!-- Product Showcase -->
    <div class="pt-8 border-t border-[#E6E6E6]">
      <h3 class="text-xl font-serif font-bold text-[#252525] mb-6">Signature Pieces From Our Atelier</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        {% render 'product-card',
          title: 'Purple Zari Silk Anarkali Suit Set',
          price: '₹3,499',
          original_price: '₹6,999',
          image: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop'
        %}
        {% render 'product-card',
          title: 'Mustard Georgette Sharara Suit Set',
          price: '₹2,799',
          original_price: '₹5,599',
          image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=600&auto=format&fit=crop'
        %}
        {% render 'product-card',
          title: 'Wine Chanderi Silk Foil Print Kurta',
          price: '₹1,299',
          original_price: '₹2,599',
          image: 'https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?q=80&w=600&auto=format&fit=crop'
        %}
        {% render 'product-card',
          title: 'Lavender Pure Organza Floral Saree',
          price: '₹2,899',
          original_price: '₹5,799',
          image: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=600&auto=format&fit=crop'
        %}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "About Page",
  "settings": []
}
{% endschema %}
