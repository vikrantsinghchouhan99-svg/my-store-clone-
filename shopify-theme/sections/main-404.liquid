        <div>
          <h2 class="text-xl font-serif font-bold text-[#252525]">Curated Festive Silhouette Grid</h2>
          <p class="text-xs text-[#737373]">Exquisite Anarkalis, Sharara sets, and hand-woven silk ensembles</p>
        </div>
        <a href="{{ routes.all_products_collection_url }}" class="text-xs font-bold text-[#71006A] hover:underline">
          View All Products →
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        {% render 'product-card',
