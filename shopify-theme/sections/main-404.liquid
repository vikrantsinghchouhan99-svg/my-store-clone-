<div class="py-12 bg-white">
  <div class="container max-w-5xl">
    
    <!-- Top Notice & Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3 mb-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#71006A]/10 text-[#71006A] text-[10px] font-bold tracking-widest uppercase font-mono">
        LIBAS EDITORIAL DIRECTORY
      </span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#252525]">
        Interactive Store Showcase
      </h1>
      <p class="text-xs sm:text-sm text-[#737373]">
        Explore our hallmark festive collection, artisan heritage story, and customer care portals directly using the quick tabs below:
      </p>
      <div class="pt-2">
        <a href="{{ routes.root_url }}" class="btn-primary">
          <span>Return To Storefront Home</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Interactive Navigation Tabs -->
    <div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto pb-4 mb-8 no-scrollbar" style="scrollbar-width: none;">
      <button type="button" data-dir-tab="products" class="dir-tab-btn active px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-[#71006A] text-white cursor-pointer border-none shadow-xs whitespace-nowrap">
        ✨ Festive Outfits
      </button>
      <button type="button" data-dir-tab="about" class="dir-tab-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-[#FAF7F9] text-[#252525] hover:bg-[#F5F5F5] cursor-pointer border border-[#E6E6E6] whitespace-nowrap">
        📖 About Libas
      </button>
      <button type="button" data-dir-tab="returns" class="dir-tab-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-[#FAF7F9] text-[#252525] hover:bg-[#F5F5F5] cursor-pointer border border-[#E6E6E6] whitespace-nowrap">
        🔄 15-Day Returns
      </button>
      <button type="button" data-dir-tab="shipping" class="dir-tab-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-[#FAF7F9] text-[#252525] hover:bg-[#F5F5F5] cursor-pointer border border-[#E6E6E6] whitespace-nowrap">
        🚚 Shipping Policy
      </button>
      <button type="button" data-dir-tab="faqs" class="dir-tab-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-[#FAF7F9] text-[#252525] hover:bg-[#F5F5F5] cursor-pointer border border-[#E6E6E6] whitespace-nowrap">
        ❓ FAQs & Help
      </button>
      <button type="button" data-dir-tab="stores" class="dir-tab-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-[#FAF7F9] text-[#252525] hover:bg-[#F5F5F5] cursor-pointer border border-[#E6E6E6] whitespace-nowrap">
        📍 Stores & Contact
      </button>
      <button type="button" data-dir-tab="legal" class="dir-tab-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-[#FAF7F9] text-[#252525] hover:bg-[#F5F5F5] cursor-pointer border border-[#E6E6E6] whitespace-nowrap">
        📜 Terms & Privacy
      </button>
    </div>

    <!-- Tab 1: Products Showcase -->
