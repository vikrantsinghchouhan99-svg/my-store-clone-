<!-- Route Dispatcher Script -->
<script>
  (function () {
    function resolveRoute() {
      var path = (window.location.pathname + window.location.hash + window.location.search).toLowerCase();
      var target = null;

      if (path.includes('suit')) target = 'suits';
      else if (path.includes('kurta')) target = 'kurtas';
      else if (path.includes('saree')) target = 'sarees';
      else if (path.includes('dress')) target = 'dresses';
      else if (path.includes('lounge') || path.includes('coord')) target = 'loungewear';
      else if (path.includes('plus') || path.includes('extra')) target = 'plus-size';
      else if (path.includes('sale')) target = 'sale';
      else if (path.includes('track')) target = 'track-order';
      else if (path.includes('return')) target = 'returns';
      else if (path.includes('ship')) target = 'shipping';
      else if (path.includes('about') || path.includes('story')) target = 'about';
      else if (path.includes('store')) target = 'stores';
      else if (path.includes('contact')) target = 'contact';
      else if (path.includes('faq')) target = 'faqs';
      else if (path.includes('wishlist')) target = 'wishlist';
      else if (path.includes('term')) target = 'terms';
      else if (path.includes('privacy')) target = 'privacy';
      else if (path.includes('sustain')) target = 'sustainability';

      document.querySelectorAll('.route-view').forEach(function (el) {
        el.style.display = 'none';
        el.classList.add('hidden');
      });

      if (target) {
        var activeEl = document.getElementById('view-' + target);
        if (activeEl) {
          activeEl.style.display = 'block';
          activeEl.classList.remove('hidden');
          var heading = activeEl.querySelector('h1, h2');
          if (heading) {
            document.title = heading.innerText.trim() + ' | Libas India';
          }
        }
      } else {
        var defEl = document.getElementById('view-default-directory');
        if (defEl) {
          defEl.style.display = 'block';
          defEl.classList.remove('hidden');
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', resolveRoute);
    } else {
      resolveRoute();
    }
  })();
</script>

