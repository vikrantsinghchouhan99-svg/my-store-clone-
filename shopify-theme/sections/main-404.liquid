<section class="py-20 bg-white text-center">
  <div class="container max-w-xl mx-auto px-4 space-y-4">
    <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold block">
      {{ section.settings.eyebrow | default: '404 • PAGE NOT FOUND' }}
    </span>
    <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#252525]">
      {{ section.settings.heading | default: 'Celebratory Style Not Found' }}
    </h1>
    <p class="text-xs sm:text-sm text-[#737373] max-w-md mx-auto leading-relaxed">
      {{ section.settings.subtext | default: 'The ensemble or page you are looking for may have been archived, renamed, or is temporarily unavailable.' }}
    </p>

    <div class="flex items-center justify-center gap-3 pt-4">
      <a href="{{ routes.root_url }}" class="px-6 py-3 rounded-lg bg-[#71006A] hover:bg-[#560050] text-white text-xs font-bold uppercase tracking-wider transition-colors shadow-md">
        Return to Home →
      </a>
      <a href="{{ routes.all_products_collection_url }}" class="px-6 py-3 rounded-lg border border-[#E6E6E6] hover:bg-[#FAF7F9] text-[#252525] text-xs font-bold uppercase tracking-wider transition-colors">
        Explore Collections
      </a>
    </div>

    <!-- Recommended Showcase -->
    <div class="pt-12 mt-12 border-t border-[#E6E6E6]">
      <h3 class="text-base font-serif font-bold text-[#252525] mb-6">Trending Celebratory Favorites</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-left">
        {% assign showcase_col = section.settings.collection %}
        {% if showcase_col != blank and showcase_col.products_count > 0 %}
          {% for product in showcase_col.products limit: 4 %}
            {% render 'product-card', product: product %}
          {% endfor %}
        {% else %}
          {% render 'product-card',
            title: 'Purple Zari Silk Anarkali Suit Set',
            price: '₹3,499',
            original_price: '₹6,999',
            image: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Mustard Georgette Sharara Suit Set',
            price: '₹2,799',
            original_price: '₹5,599',
            image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Wine Chanderi Silk Foil Print Kurta',
            price: '₹1,299',
            original_price: '₹2,599',
            image: 'https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Lavender Pure Organza Floral Saree',
            price: '₹2,899',
            original_price: '₹5,799',
            image: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=600&auto=format&fit=crop'
          %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "404 • PAGE NOT FOUND"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Celebratory Style Not Found"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "The ensemble or page you are looking for may have been archived, renamed, or is temporarily unavailable."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Showcase Collection"
    }
  ]
}
{% endschema %}
