<!-- The Libas Atelier Craftsmanship Section -->
<section class="py-16 bg-[#FAF7F9] border-y border-[#E6E6E6]">
  <div class="container max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      
      <!-- Visual Mosaic -->
      <div class="grid grid-cols-2 gap-4">
        <div class="rounded-2xl overflow-hidden aspect-[3/4] bg-white shadow-sm">
          {% if section.settings.image_1 != blank %}
            {{ section.settings.image_1 | image_url: width: 600 | image_tag: class: 'w-full h-full object-cover hover:scale-105 transition-transform duration-500', loading: 'lazy' }}
          {% else %}
            <img
              src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=600&auto=format&fit=crop"
              alt="Zari Embroidery Craft"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              loading="lazy"
            >
          {% endif %}
        </div>
        <div class="rounded-2xl overflow-hidden aspect-[3/4] bg-white shadow-sm pt-6">
          {% if section.settings.image_2 != blank %}
            {{ section.settings.image_2 | image_url: width: 600 | image_tag: class: 'w-full h-full object-cover hover:scale-105 transition-transform duration-500', loading: 'lazy' }}
          {% else %}
            <img
              src="https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?q=80&w=600&auto=format&fit=crop"
              alt="Artisanal Hand block"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              loading="lazy"
            >
          {% endif %}
        </div>
      </div>

      <!-- Content -->
      <div class="space-y-5">
        {% if section.settings.eyebrow != blank %}
          <span class="text-[10px] font-mono tracking-widest uppercase font-extrabold text-[#71006A]">
            {{ section.settings.eyebrow }}
          </span>
        {% endif %}
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#252525] leading-tight">
          {{ section.settings.heading | default: 'Authentic Craftsmanship.' }} <br>
          <span class="text-[#71006A]">{{ section.settings.heading_highlight | default: 'Tailored for Modern Celebrations.' }}</span>
        </h2>
        <p class="text-xs sm:text-sm text-[#4D4D4D] leading-relaxed">
          {{ section.settings.description | default: 'Every Libas creation represents a harmony between India’s time-honored textile heritage and contemporary sensibilities. From pure Chanderi weaves to handcrafted Rajasthani gotta patti and Lucknowi resham stitches.' }}
        </p>

        <!-- Feature Points -->
        <div class="space-y-3.5 pt-2 text-xs">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <div class="flex gap-3.5 items-start" {{ block.shopify_attributes }}>
                <div class="w-8 h-8 rounded-lg bg-white border border-[#E6E6E6] flex items-center justify-center shrink-0 text-[#71006A] shadow-xs">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <div>
                  <h4 class="font-bold text-[#252525]">{{ block.settings.title }}</h4>
                  <p class="text-[#737373] text-[11px] mt-0.5">
                    {{ block.settings.description }}
                  </p>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <!-- Default points -->
            <div class="flex gap-3.5 items-start">
              <div class="w-8 h-8 rounded-lg bg-white border border-[#E6E6E6] flex items-center justify-center shrink-0 text-[#71006A] shadow-xs">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><line x1="20" y1="4" x2="8.12" y2="15.88"></line><line x1="14.47" y1="14.48" x2="20" y2="20"></line><line x1="8.12" y1="8.12" x2="12" y2="12"></line></svg>
              </div>
              <div>
                <h4 class="font-bold text-[#252525]">Bespoke Grading & Fit</h4>
                <p class="text-[#737373] text-[11px] mt-0.5">Tailored with comfort-stretch waistbands and roomier armhole cuts for easy movement.</p>
              </div>
            </div>
            <div class="flex gap-3.5 items-start">
              <div class="w-8 h-8 rounded-lg bg-white border border-[#E6E6E6] flex items-center justify-center shrink-0 text-[#71006A] shadow-xs">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              </div>
              <div>
                <h4 class="font-bold text-[#252525]">Azo-Free Certified Natural Dyes</h4>
                <p class="text-[#737373] text-[11px] mt-0.5">Gentle on festive skin and protective of Rajasthan and Gujarat groundwater reservoirs.</p>
              </div>
            </div>
            <div class="flex gap-3.5 items-start">
              <div class="w-8 h-8 rounded-lg bg-white border border-[#E6E6E6] flex items-center justify-center shrink-0 text-[#71006A] shadow-xs">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              </div>
              <div>
                <h4 class="font-bold text-[#252525]">Direct from Weaver to Wardrobe</h4>
                <p class="text-[#737373] text-[11px] mt-0.5">Fair remuneration for regional master artisans across Jaipur, Chanderi, and Varanasi.</p>
              </div>
            </div>
          {% endif %}
        </div>

        {% if section.settings.btn_text != blank %}
          <div class="pt-2">
            <a
              href="{{ section.settings.btn_link | default: '/collections/suits' }}"
              class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-[#71006A] text-white text-xs font-bold uppercase tracking-wider hover:bg-[#5C0056] shadow-sm transition-all"
            >
              <span>{{ section.settings.btn_text }}</span>
              <span>→</span>
            </a>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Atelier Craft",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE LIBAS ATELIER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Line 1",
      "default": "Authentic Craftsmanship."
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Line 2",
      "default": "Tailored for Modern Celebrations."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every Libas creation represents a harmony between India’s time-honored textile heritage and contemporary sensibilities. From pure Chanderi weaves to handcrafted Rajasthani gotta patti and Lucknowi resham stitches."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Mosaic Left Image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Mosaic Right Image"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Explore The Atelier Edit"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "craft_point",
      "name": "Craft Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Bespoke Grading & Fit"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature Description",
          "default": "Tailored with comfort-stretch waistbands and roomier armhole cuts for easy movement."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atelier Craft",
      "blocks": [
        {
          "type": "craft_point",
          "settings": {
            "title": "Bespoke Grading & Fit",
            "description": "Tailored with comfort-stretch waistbands and roomier armhole cuts for easy movement."
          }
        },
        {
          "type": "craft_point",
          "settings": {
            "title": "Azo-Free Certified Natural Dyes",
            "description": "Gentle on festive skin and protective of Rajasthan and Gujarat groundwater reservoirs."
          }
        },
        {
          "type": "craft_point",
          "settings": {
            "title": "Direct from Weaver to Wardrobe",
            "description": "Fair remuneration for regional master artisans across Jaipur, Chanderi, and Varanasi."
          }
        }
      ]
    }
  ]
}
{% endschema %}
