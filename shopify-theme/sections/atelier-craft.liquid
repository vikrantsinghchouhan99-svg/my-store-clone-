<!-- The Libas Atelier Craftsmanship Section -->
<section class="py-16 bg-[#FAF7F9] border-y border-[#E6E6E6]">
  <div class="container max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      
      <!-- Visual Mosaic -->
      <div class="grid grid-cols-2 gap-4">
        <div class="rounded-2xl overflow-hidden aspect-[3/4] bg-white shadow-sm">
          <img
            src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=600&auto=format&fit=crop"
            alt="Zari Embroidery Craft"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          >
        </div>
        <div class="rounded-2xl overflow-hidden aspect-[3/4] bg-white shadow-sm pt-6">
          <img
            src="https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?q=80&w=600&auto=format&fit=crop"
            alt="Artisanal Hand block"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          >
        </div>
      </div>

      <!-- Content -->
      <div class="space-y-5">
        <span class="text-[10px] font-mono tracking-widest uppercase font-extrabold text-[#71006A]">
          THE LIBAS ATELIER
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#252525] leading-tight">
          Authentic Craftsmanship. <br>
          <span class="text-[#71006A]">Tailored for Modern Celebrations.</span>
        </h2>
        <p class="text-xs sm:text-sm text-[#4D4D4D] leading-relaxed">
          Every Libas creation represents a harmony between India’s time-honored textile heritage and contemporary sensibilities. From pure Chanderi weaves to handcrafted Rajasthani gotta patti and Lucknowi resham stitches.
        </p>

        <div class="space-y-3.5 pt-2 text-xs">
          <!-- Item 1 -->
          <div class="flex gap-3.5 items-start">
            <div class="w-8 h-8 rounded-lg bg-white border border-[#E6E6E6] flex items-center justify-center shrink-0 text-[#71006A]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><line x1="20" y1="4" x2="8.12" y2="15.88"></line><line x1="14.47" y1="14.48" x2="20" y2="20"></line><line x1="8.12" y1="8.12" x2="12" y2="12"></line></svg>
            </div>
            <div>
              <h4 class="font-bold text-[#252525]">Bespoke Grading & Fit</h4>
              <p class="text-[#737373] text-[11px] mt-0.5">
                Tailored with comfort-stretch waistbands and roomier armhole cuts for easy movement.
              </p>
            </div>
          </div>

          <!-- Item 2 -->
          <div class="flex gap-3.5 items-start">
            <div class="w-8 h-8 rounded-lg bg-white border border-[#E6E6E6] flex items-center justify-center shrink-0 text-[#71006A]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"></path><line x1="16" y1="8" x2="2" y2="22"></line><line x1="17.5" y1="15" x2="9" y2="15"></line></svg>
            </div>
            <div>
              <h4 class="font-bold text-[#252525]">Natural Breathable Weaves</h4>
              <p class="text-[#737373] text-[11px] mt-0.5">
                Premium 60s combed cotton, pure silk blends, and featherweight organza that stay fresh all day.
              </p>
            </div>
          </div>

          <!-- Item 3 -->
          <div class="flex gap-3.5 items-start">
            <div class="w-8 h-8 rounded-lg bg-white border border-[#E6E6E6] flex items-center justify-center shrink-0 text-[#71006A]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
            </div>
            <div>
              <h4 class="font-bold text-[#252525]">Direct from Weaver to Wardrobe</h4>
              <p class="text-[#737373] text-[11px] mt-0.5">
                Fair remuneration for regional master artisans across Jaipur, Chanderi, and Varanasi.
              </p>
            </div>
          </div>
        </div>

        <div class="pt-2">
          <a
            href="/collections/suits"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-[#71006A] text-white text-xs font-bold uppercase tracking-wider hover:bg-[#5C0056] shadow-sm transition-all"
          >
            <span>Explore The Atelier Edit</span>
            <span>→</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Atelier Craft",
  "settings": []
}
{% endschema %}