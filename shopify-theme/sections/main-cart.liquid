<div class="py-14 bg-white min-h-[60vh]">
  <div class="container max-w-4xl">
    <div class="text-center space-y-2 mb-10">
      <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold">
        {{ section.settings.eyebrow | default: 'CHECKOUT & REVIEW' }}
      </span>
      <h1 class="text-3xl font-serif font-bold text-[#252525]">
        {{ section.settings.heading | default: 'Your Shopping Bag' }}
      </h1>
    </div>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" id="cart" class="space-y-6">
        <div class="bg-[#FAF7F9] border border-[#E6E6E6] rounded-2xl p-6 sm:p-8 space-y-4">
          {% for item in cart.items %}
            <div class="flex flex-col sm:flex-row gap-4 p-4 bg-white border border-[#E6E6E6] rounded-xl items-start sm:items-center justify-between">
              <div class="flex gap-4 items-center">
                <div class="w-16 h-20 rounded-lg overflow-hidden bg-[#F5F5F5] shrink-0">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="w-full h-full object-cover">
                  {% endif %}
                </div>
                <div>
                  <a href="{{ item.url }}" class="text-sm font-bold text-[#252525] hover:text-[#71006A] transition-colors">{{ item.product.title }}</a>
                  {% unless item.product.has_only_default_variant %}
                    <p class="text-xs text-[#737373] mt-0.5">{{ item.variant.title }}</p>
                  {% endunless %}
                  <div class="text-sm font-bold text-[#71006A] mt-1">{{ item.final_price | money }}</div>
                </div>
              </div>

              <div class="flex items-center gap-4 w-full sm:w-auto justify-between sm:justify-end border-t sm:border-t-0 pt-3 sm:pt-0 border-[#E6E6E6]">
                <div class="flex items-center border border-[#E6E6E6] rounded-lg bg-white overflow-hidden">
                  <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="px-2.5 py-1 text-xs text-[#737373] hover:bg-[#F5F5F5]">-</a>
                  <span class="px-3 py-1 text-xs font-bold text-[#252525]">{{ item.quantity }}</span>
                  <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="px-2.5 py-1 text-xs text-[#737373] hover:bg-[#F5F5F5]">+</a>
                </div>
                <div class="text-sm font-bold text-[#252525]">{{ item.final_line_price | money }}</div>
                <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="text-xs text-red-500 hover:text-red-700 ml-2" title="Remove">✕</a>
              </div>
            </div>
          {% endfor %}

          <!-- Action -->
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-[#E6E6E6]">
            <div>
              <span class="text-xs text-[#737373] block">Subtotal (Taxes & Shipping calculated at checkout):</span>
              <span class="text-2xl font-serif font-bold text-[#71006A]">{{ cart.total_price | money }}</span>
            </div>

            <div class="flex items-center gap-3 w-full sm:w-auto">
              <a href="{{ routes.all_products_collection_url }}" class="w-full sm:w-auto px-6 py-3.5 rounded-lg border border-[#E6E6E6] bg-white text-[#252525] text-xs font-bold uppercase tracking-wider text-center hover:bg-[#F5F5F5]">
                Continue Shopping
              </a>
              <button
                type="submit"
                name="checkout"
                class="w-full sm:w-auto px-8 py-3.5 rounded-lg bg-[#71006A] hover:bg-[#560050] text-white text-xs font-bold uppercase tracking-wider transition-colors shadow-md text-center"
              >
                Proceed to Checkout →
              </button>
            </div>
          </div>
        </div>
      </form>
    {% else %}
      <div class="text-center py-16 bg-[#FAF7F9] border border-[#E6E6E6] rounded-2xl max-w-xl mx-auto space-y-4">
        <div class="w-16 h-16 rounded-full bg-white flex items-center justify-center mx-auto text-2xl shadow-xs">🛍️</div>
        <h3 class="text-lg font-serif font-bold text-[#252525]">{{ section.settings.empty_title | default: 'Your Shopping Bag is Empty' }}</h3>
        <p class="text-xs text-[#737373] max-w-sm mx-auto">{{ section.settings.empty_text | default: 'Looks like you have not added any styles to your bag yet. Explore our festive arrivals!' }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="inline-block px-8 py-3 rounded-lg bg-[#71006A] text-white text-xs font-bold uppercase tracking-wider hover:bg-[#560050] shadow-md transition-colors">
          Start Shopping
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "CHECKOUT & REVIEW" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Shopping Bag" },
    { "type": "text", "id": "empty_title", "label": "Empty State Title", "default": "Your Shopping Bag is Empty" },
    { "type": "textarea", "id": "empty_text", "label": "Empty State Message", "default": "Looks like you have not added any styles to your bag yet. Explore our festive arrivals!" }
  ]
}
{% endschema %}
