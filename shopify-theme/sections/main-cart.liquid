<div class="py-14 bg-white min-h-[60vh]">
  <div class="container max-w-4xl">
    <div class="text-center space-y-2 mb-10">
      <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold">
        CHECKOUT & REVIEW
      </span>
      <h1 class="text-3xl font-serif font-bold text-[#252525]">
        Your Shopping Bag
      </h1>
    </div>

    <div class="bg-[#FAF7F9] border border-[#E6E6E6] rounded-2xl p-6 sm:p-8 space-y-6">
      <!-- Item Preview -->
      <div class="flex gap-4 p-4 bg-white border border-[#E6E6E6] rounded-xl items-center">
        <div class="w-16 h-20 rounded-lg overflow-hidden bg-[#F5F5F5]">
          <img src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=200&auto=format&fit=crop" alt="Item" class="w-full h-full object-cover">
        </div>
        <div class="flex-1">
          <h4 class="text-sm font-bold text-[#252525]">Purple Zari Embroidered Silk Anarkali Suit Set</h4>
          <p class="text-xs text-[#737373]">Size: L • Free Doorstep Shipping</p>
          <span class="text-sm font-bold text-[#71006A] mt-1 block">₹3,499</span>
        </div>
      </div>

      <!-- Action -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-[#E6E6E6]">
        <div>
          <span class="text-xs text-[#737373] block">Subtotal:</span>
          <span class="text-2xl font-serif font-bold text-[#71006A]">₹3,499</span>
        </div>

        <button
          type="button"
          data-checkout-trigger
          class="w-full sm:w-auto px-8 py-3.5 rounded-lg bg-[#71006A] hover:bg-[#560050] text-white text-xs font-bold uppercase tracking-wider transition-colors shadow-md"
        >
          Proceed to Pay (COD / UPI / Card)
        </button>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
