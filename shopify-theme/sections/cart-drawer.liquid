<div id="CartDrawerOverlay" class="drawer-overlay"></div>

<aside id="CartDrawer" class="cart-drawer">
  <!-- Drawer Header -->
  <div class="p-4 border-b border-[#E6E6E6] flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="text-xs font-bold uppercase tracking-wider text-[#71006A] font-mono">
        Your Shopping Bag
      </span>
      <span class="bg-[#FAF7F9] text-[#71006A] px-2 py-0.5 rounded-full text-[10px] font-bold border border-[#E6E6E6]">
        {{ cart.item_count | default: 1 }} items
      </span>
    </div>
    <button type="button" data-cart-drawer-close class="text-[#737373] hover:text-black">
      {% render 'icon-close' %}
    </button>
  </div>

  <!-- Free Shipping Meter -->
  <div class="p-4 bg-[#FAF7F9] border-b border-[#E6E6E6] space-y-1.5">
    <div class="flex items-center justify-between text-xs">
      <span class="font-bold text-[#252525]">🎉 Free Domestic Shipping Unlocked!</span>
      <span class="text-[10px] text-emerald-700 font-bold">100% Eligible</span>
    </div>
    <div class="w-full bg-[#E6E6E6] h-1.5 rounded-full overflow-hidden">
      <div class="bg-emerald-600 h-full w-full rounded-full"></div>
    </div>
    <p class="text-[10px] text-[#737373]">All orders above ₹999 qualify for complimentary doorstep courier delivery.</p>
  </div>

  <!-- Items Scroll Area -->
  <div class="flex-1 overflow-y-auto p-4 space-y-3">
    {% if cart.item_count > 0 %}
      {% for item in cart.items %}
        <div class="flex gap-3 p-3 bg-white border border-[#E6E6E6] rounded-xl">
          <div class="w-16 h-20 rounded-lg bg-[#F5F5F5] overflow-hidden shrink-0">
            <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.title | escape }}" class="w-full h-full object-cover">
          </div>
          <div class="flex-1 flex flex-col justify-between">
            <div>
              <h4 class="text-xs font-bold text-[#252525] line-clamp-1">{{ item.product.title }}</h4>
              <p class="text-[10px] text-[#737373]">Size: {{ item.variant.title }}</p>
            </div>
            <div class="flex items-center justify-between pt-1">
              <span class="text-xs font-bold text-[#71006A]">{{ item.price | money }}</span>
              <span class="text-xs text-[#737373]">Qty: {{ item.quantity }}</span>
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <!-- Sample Item for Interactive Demo -->
      <div class="flex gap-3 p-3 bg-white border border-[#E6E6E6] rounded-xl">
        <div class="w-16 h-20 rounded-lg bg-[#F5F5F5] overflow-hidden shrink-0">
          <img src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=200&auto=format&fit=crop" alt="Demo Item" class="w-full h-full object-cover">
        </div>
        <div class="flex-1 flex flex-col justify-between">
          <div>
            <h4 class="text-xs font-bold text-[#252525] line-clamp-1">Purple Zari Silk Anarkali Suit Set</h4>
            <p class="text-[10px] text-[#737373]">Size: L • Royal Plum</p>
          </div>
          <div class="flex items-center justify-between pt-1">
            <span class="text-xs font-bold text-[#71006A]">₹3,499</span>
            <span class="text-xs text-[#737373]">Qty: 1</span>
          </div>
        </div>
      </div>
    {% endif %}
  </div>

  <!-- Promo Code & Checkout Footer -->
  <div class="p-4 border-t border-[#E6E6E6] bg-white space-y-3">
    <div class="flex items-center justify-between p-2.5 rounded-lg bg-[#FAF7F9] border border-dashed border-[#71006A]/40 text-xs">
      <span class="font-mono font-bold text-[#71006A]">PREPAID10</span>
      <span class="text-[10px] text-emerald-700 font-bold">10% Off Applied</span>
    </div>

    <div class="flex items-baseline justify-between text-xs">
      <span class="text-[#737373]">Subtotal</span>
      <span class="text-base font-serif font-bold text-[#71006A]">{{ cart.total_price | money | default: '₹3,499' }}</span>
    </div>

    <button
      type="button"
      data-checkout-trigger
      class="w-full py-3 rounded-lg bg-[#71006A] hover:bg-[#560050] text-white text-xs font-bold uppercase tracking-wider transition-colors shadow-md flex items-center justify-center gap-2"
    >
      <span>Proceed to Pay</span>
      <span>→</span>
    </button>
  </div>
</aside>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}
