<div class="py-12 bg-white">
  <div class="container max-w-5xl">
    
    <div class="text-center max-w-2xl mx-auto space-y-3 mb-12">
      <span class="text-[10px] font-mono tracking-widest uppercase text-emerald-800 font-extrabold">
        {{ section.settings.eyebrow | default: 'CONSCIOUS ETHNIC FASHION' }}
      </span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#252525]">
        {{ section.settings.heading | default: 'Sustainability & Mindful Craft' }}
      </h1>
      <p class="text-xs sm:text-sm text-[#737373]">
        {{ section.settings.description | default: '100% organic cotton, azo-free natural dyes, zero single-use plastic packaging, and ethical artisan living wages.' }}
      </p>
    </div>

    <!-- 4 Commitments -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-14">
      <div class="p-5 rounded-2xl bg-[#FAF7F9] border border-[#E6E6E6] space-y-2">
        <h4 class="text-xs font-bold text-[#252525]">🌿 100% Organic Cotton</h4>
        <p class="text-xs text-[#737373]">Grown without harmful chemical pesticides, keeping soil and groundwater clean.</p>
      </div>
      <div class="p-5 rounded-2xl bg-[#FAF7F9] border border-[#E6E6E6] space-y-2">
        <h4 class="text-xs font-bold text-[#252525]">💧 Non-Toxic Dyes</h4>
        <p class="text-xs text-[#737373]">Safe mineral and botanical pigments with closed-loop water treatment.</p>
      </div>
      <div class="p-5 rounded-2xl bg-[#FAF7F9] border border-[#E6E6E6] space-y-2">
        <h4 class="text-xs font-bold text-[#252525]">📦 Zero Plastic Boxes</h4>
        <p class="text-xs text-[#737373]">100% compostable cornstarch mailers and recyclable FSC cardboard.</p>
      </div>
      <div class="p-5 rounded-2xl bg-[#FAF7F9] border border-[#E6E6E6] space-y-2">
        <h4 class="text-xs font-bold text-[#252525]">🤝 Fair Artisan Wages</h4>
        <p class="text-xs text-[#737373]">Direct livelihood support for over 2,500 rural weaver families.</p>
      </div>
    </div>

    <!-- Product Showcase -->
    <div class="pt-8 border-t border-[#E6E6E6]">
      <h3 class="text-xl font-serif font-bold text-[#252525] mb-6">{{ section.settings.showcase_heading | default: 'Conscious 100% Pure Cotton Edit' }}</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        {% assign showcase_col = section.settings.collection %}
        {% if showcase_col != blank and showcase_col.products_count > 0 %}
          {% for product in showcase_col.products limit: 4 %}
            {% render 'product-card', product: product %}
          {% endfor %}
        {% else %}
          {% render 'product-card',
            title: 'Blush Pink Pure Cotton Straight Kurta Palazzo Set',
            price: '₹1,499',
            original_price: '₹2,999',
            image: 'https://images.unsplash.com/photo-1596783074918-c84cb06531ca?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Wine Chanderi Silk Foil Print Kurta',
            price: '₹1,299',
            original_price: '₹2,599',
            image: 'https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Mustard Georgette Sharara Suit Set',
            price: '₹2,799',
            original_price: '₹5,599',
            image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Indigo Blue Ajrakh Handblock Cotton Kurta',
            price: '₹1,099',
            original_price: '₹2,199',
            image: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=600&auto=format&fit=crop'
          %}
        {% endif %}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Sustainability Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "CONSCIOUS ETHNIC FASHION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sustainability & Mindful Craft" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "100% organic cotton, azo-free natural dyes, zero single-use plastic packaging, and ethical artisan living wages." },
    { "type": "text", "id": "showcase_heading", "label": "Showcase Heading", "default": "Conscious 100% Pure Cotton Edit" },
    { "type": "collection", "id": "collection", "label": "Showcase Collection" }
  ],
  "presets": [
    { "name": "Sustainability Page" }
  ]
}
{% endschema %}
