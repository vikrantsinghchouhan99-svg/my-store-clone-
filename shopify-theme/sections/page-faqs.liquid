<div id="faqs" class="py-12 bg-white border-b border-[#E6E6E6]">
  <div class="container max-w-4xl">
    
    <div class="text-center space-y-3 mb-10">
      <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold">
        {{ section.settings.eyebrow | default: 'HELP DESK & KNOWLEDGE BASE' }}
      </span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#252525]">
        {{ section.settings.heading | default: 'Frequently Asked Questions' }}
      </h1>
      <p class="text-xs sm:text-sm text-[#737373]">
        {{ section.settings.subheading | default: 'Quick answers about order tracking, payments, refunds, and sizes.' }}
      </p>
    </div>

    <!-- Accordion Items -->
    <div class="space-y-3 mb-14 text-xs sm:text-sm">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <details class="p-4 rounded-xl border border-[#E6E6E6] bg-[#FAF7F9]/30" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="font-bold text-[#252525] cursor-pointer">{{ block.settings.question }}</summary>
            <p class="mt-2 text-xs text-[#4D4D4D] leading-relaxed">
              {{ block.settings.answer }}
            </p>
          </details>
        {% endfor %}
      {% else %}
        <details class="p-4 rounded-xl border border-[#E6E6E6] bg-[#FAF7F9]/30" open>
          <summary class="font-bold text-[#252525] cursor-pointer">How do I track my Libas order in real time?</summary>
          <p class="mt-2 text-xs text-[#4D4D4D] leading-relaxed">
            Navigate to our "Track Order" page in the navigation or footer. Enter your Order ID (e.g. LIB-884920) and phone number to see live courier milestones.
          </p>
        </details>

        <details class="p-4 rounded-xl border border-[#E6E6E6] bg-[#FAF7F9]/30">
          <summary class="font-bold text-[#252525] cursor-pointer">Which payment options are supported?</summary>
          <p class="mt-2 text-xs text-[#4D4D4D] leading-relaxed">
            We accept Cash on Delivery (COD), UPI (Google Pay, PhonePe, Paytm, QR), Credit & Debit cards (Visa, MasterCard, RuPay), and Net Banking. All transactions are 256-bit encrypted.
          </p>
        </details>

        <details class="p-4 rounded-xl border border-[#E6E6E6] bg-[#FAF7F9]/30">
          <summary class="font-bold text-[#252525] cursor-pointer">What is the return and exchange policy?</summary>
          <p class="mt-2 text-xs text-[#4D4D4D] leading-relaxed">
            We offer 15-day free doorstep returns and exchanges. Brand tags must remain attached and the item unwashed.
          </p>
        </details>

        <details class="p-4 rounded-xl border border-[#E6E6E6] bg-[#FAF7F9]/30">
          <summary class="font-bold text-[#252525] cursor-pointer">What sizes are supported in ExtraLove?</summary>
          <p class="mt-2 text-xs text-[#4D4D4D] leading-relaxed">
            ExtraLove features tailored fits across 3XL (46), 4XL (48), 5XL (50), and 6XL (52) with custom comfort-stretch waistbands.
          </p>
        </details>
      {% endif %}
    </div>

    <!-- Featured Products -->
    {% assign faqs_coll = section.settings.collection %}
    <div class="pt-8 border-t border-[#E6E6E6]">
      <h3 class="text-xl font-serif font-bold text-[#252525] mb-6">Trending Festive Styles</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {% if faqs_coll != blank and faqs_coll.products.size > 0 %}
          {% for product in faqs_coll.products limit: 4 %}
            {% render 'product-card', product: product %}
          {% endfor %}
        {% else %}
          {% render 'product-card',
            title: 'Purple Zari Silk Anarkali Suit Set',
            price: '₹3,499',
            original_price: '₹6,999',
            image: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Mustard Georgette Sharara Suit Set',
            price: '₹2,799',
            original_price: '₹5,599',
            image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Wine Chanderi Silk Foil Print Kurta',
            price: '₹1,299',
            original_price: '₹2,599',
            image: 'https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Lavender Pure Organza Floral Saree',
            price: '₹2,899',
            original_price: '₹5,799',
            image: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=600&auto=format&fit=crop'
          %}
        {% endif %}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "FAQs Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "HELP DESK & KNOWLEDGE BASE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Quick answers about order tracking, payments, refunds, and sizes."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Showcase Collection"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I track my Libas order in real time?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Navigate to our 'Track Order' page in the navigation or footer. Enter your Order ID (e.g. LIB-884920) and phone number to see live courier milestones."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQs Page",
