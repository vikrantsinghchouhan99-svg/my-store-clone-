<div class="py-12 bg-white">
  <div class="container max-w-4xl space-y-8 text-xs sm:text-sm text-[#4D4D4D] leading-relaxed">
    <div class="text-center space-y-2 mb-8">
      <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold">
        {{ section.settings.eyebrow | default: 'LEGAL TERMS' }}
      </span>
      <h1 class="text-3xl font-serif font-bold text-[#252525]">
        {{ section.settings.heading | default: 'Terms & Conditions' }}
      </h1>
    </div>

    <section class="space-y-2">
      <h2 class="text-sm font-bold text-[#252525]">1. Acceptance of Terms</h2>
      <p>By purchasing from Libas or browsing our digital storefront, you accept these commercial terms and conditions.</p>
    </section>

    <section class="space-y-2">
      <h2 class="text-sm font-bold text-[#252525]">2. Account Security & Verification</h2>
      <p>To safeguard customer profiles, accounts are protected by multi-tier encryption and secure session verification.</p>
    </section>

    <section class="space-y-2">
      <h2 class="text-sm font-bold text-[#252525]">3. Pricing & Payments</h2>
      <p>All prices include applicable GST. We support Cash on Delivery, UPI, Cards, and Net Banking through PCI-DSS gateways.</p>
    </section>

    <div class="pt-8 border-t border-[#E6E6E6]">
      <h3 class="text-base font-serif font-bold text-[#252525] mb-4">Trending Festive Favorites</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {% assign showcase_col = section.settings.collection %}
        {% if showcase_col != blank and showcase_col.products_count > 0 %}
          {% for product in showcase_col.products limit: 4 %}
            {% render 'product-card', product: product %}
          {% endfor %}
        {% else %}
          {% render 'product-card',
            title: 'Purple Zari Silk Anarkali Suit Set',
            price: '₹3,499',
            original_price: '₹6,999',
            image: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Mustard Georgette Sharara Suit Set',
            price: '₹2,799',
            original_price: '₹5,599',
            image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Wine Chanderi Silk Foil Print Kurta',
            price: '₹1,299',
            original_price: '₹2,599',
            image: 'https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?q=80&w=600&auto=format&fit=crop'
          %}
          {% render 'product-card',
            title: 'Lavender Pure Organza Floral Saree',
            price: '₹2,899',
            original_price: '₹5,799',
            image: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=600&auto=format&fit=crop'
          %}
        {% endif %}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Terms & Conditions",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "LEGAL TERMS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Terms & Conditions" },
    { "type": "collection", "id": "collection", "label": "Showcase Collection" }
  ],
  "presets": [
    { "name": "Terms & Conditions" }
  ]
}
{% endschema %}
