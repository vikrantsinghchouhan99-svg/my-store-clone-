<div class="py-10 bg-white min-h-[70vh]">
  <div class="container">
    
    <!-- Collection Header -->
    <div class="text-center max-w-2xl mx-auto space-y-2 mb-8">
      <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold" id="coll-eyebrow">
        LIBAS FESTIVE EDIT
      </span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#252525]" id="coll-heading">
        {{ collection.title | default: 'All Festive Collections' }}
      </h1>
      <p class="text-xs sm:text-sm text-[#737373]" id="coll-tagline">
        {{ collection.description | default: 'Explore our hallmark Indian ethnic silhouettes crafted in comfortable fabrics and festive hand-embroidered finishes.' }}
      </p>
    </div>

    <!-- Subcategory Chips -->
    {% if section.settings.enable_filtering %}
      <div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto pb-4 mb-6 no-scrollbar" id="collection-chips" style="scrollbar-width: none;">
        <button type="button" data-filter-subcat="all" class="subcat-chip active px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#71006A] text-white cursor-pointer border-none shadow-xs whitespace-nowrap">
          All Styles
        </button>
        <button type="button" data-filter-subcat="anarkali" class="subcat-chip px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#FAF7F9] text-[#252525] hover:bg-[#F5F5F5] cursor-pointer border border-[#E6E6E6] whitespace-nowrap">
          Anarkali
        </button>
        <button type="button" data-filter-subcat="sharara" class="subcat-chip px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#FAF7F9] text-[#252525] hover:bg-[#F5F5F5] cursor-pointer border border-[#E6E6E6] whitespace-nowrap">
          Sharara Sets
        </button>
        <button type="button" data-filter-subcat="palazzo" class="subcat-chip px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#FAF7F9] text-[#252525] hover:bg-[#F5F5F5] cursor-pointer border border-[#E6E6E6] whitespace-nowrap">
          Palazzo Sets
        </button>
        <button type="button" data-filter-subcat="straight" class="subcat-chip px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#FAF7F9] text-[#252525] hover:bg-[#F5F5F5] cursor-pointer border border-[#E6E6E6] whitespace-nowrap">
          Straight Cut
        </button>
        <button type="button" data-filter-subcat="sarees" class="subcat-chip px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#FAF7F9] text-[#252525] hover:bg-[#F5F5F5] cursor-pointer border border-[#E6E6E6] whitespace-nowrap">
          Sarees
        </button>
        <button type="button" data-filter-subcat="dresses" class="subcat-chip px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#FAF7F9] text-[#252525] hover:bg-[#F5F5F5] cursor-pointer border border-[#E6E6E6] whitespace-nowrap">
          Ethnic Dresses
        </button>
        <button type="button" data-filter-subcat="plus" class="subcat-chip px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#FAF7F9] text-[#252525] hover:bg-[#F5F5F5] cursor-pointer border border-[#E6E6E6] whitespace-nowrap">
          ExtraLove (3XL-6XL)
        </button>
      </div>
    {% endif %}

    <!-- Toolbar: Active Count & Sort -->
    <div class="flex items-center justify-between pb-4 border-b border-[#E6E6E6] mb-8 text-xs text-[#737373]">
      <div>
        Showing <span id="product-count" class="font-bold text-[#252525]">{{ collection.all_products_count | default: 12 }}</span> festive silhouettes
      </div>
      {% if section.settings.enable_sorting %}
        <div class="flex items-center gap-2">
          <label for="coll-sort" class="font-bold text-[#252525]">Sort By:</label>
          <select id="coll-sort" class="px-3 py-1.5 rounded-lg border border-[#E6E6E6] bg-white text-xs text-[#252525] outline-none">
            <option value="featured">Featured / Trending</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="discount">Biggest Discount</option>
          </select>
        </div>
      {% endif %}
    </div>

    <!-- Product Grid -->
    {% assign per_page = section.settings.products_per_page | default: 16 %}
    {%- paginate collection.products by per_page -%}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6" id="collection-grid">
        {%- if collection.products.size > 0 -%}
          {%- for product in collection.products -%}
            <div class="product-item" data-price="{{ product.price | divided_by: 100 }}" data-category="{{ product.type | default: 'suits' | downcase }}">
              {% render 'product-card', product: product %}
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Fallback items when previewing or without Shopify products -->
          <div class="product-item" data-category="suits" data-subcategory="anarkali" data-price="3499">
            {% render 'product-card',
              title: 'Purple Zari Embroidered Silk Anarkali Suit Set',
              price: '₹3,499',
              original_price: '₹6,999',
              image: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop'
            %}
          </div>
          <div class="product-item" data-category="suits" data-subcategory="sharara" data-price="2799">
            {% render 'product-card',
              title: 'Mustard Gotta Patti Georgette Sharara Suit Set',
              price: '₹2,799',
              original_price: '₹5,599',
              image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=600&auto=format&fit=crop'
            %}
          </div>
          <div class="product-item" data-category="suits" data-subcategory="palazzo" data-price="1899">
            {% render 'product-card',
              title: 'Blush Floral Pure Cotton Straight Kurta & Palazzo Set',
              price: '₹1,899',
              original_price: '₹3,799',
              image: 'https://images.unsplash.com/photo-1596783074918-c84cb06531ca?q=80&w=600&auto=format&fit=crop'
            %}
          </div>
          <div class="product-item" data-category="suits" data-subcategory="straight" data-price="4499">
            {% render 'product-card',
              title: 'Emerald Green Embroidered Velvet Suit Set',
              price: '₹4,499',
              original_price: '₹8,999',
              image: 'https://images.unsplash.com/photo-1558769132-cb1aea458c5e?q=80&w=600&auto=format&fit=crop'
            %}
          </div>
          <div class="product-item" data-category="sarees" data-subcategory="sarees" data-price="2699">
            {% render 'product-card',
              title: 'Burgundy Zari Woven Sheer Organza Saree',
              price: '₹2,699',
              original_price: '₹5,399',
              image: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=600&auto=format&fit=crop'
            %}
          </div>
          <div class="product-item" data-category="dresses" data-subcategory="dresses" data-price="1999">
            {% render 'product-card',
              title: 'Teal Green Angrakha Tiered Festive Maxi Gown',
              price: '₹1,999',
              original_price: '₹4,599',
              image: 'https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?q=80&w=600&auto=format&fit=crop'
            %}
          </div>
          <div class="product-item" data-category="plus" data-subcategory="plus" data-price="3199">
            {% render 'product-card',
              title: 'ExtraLove Mustard Flared Anarkali Suit Set (3XL-6XL)',
              price: '₹3,199',
              original_price: '₹6,399',
              image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=600&auto=format&fit=crop'
            %}
          </div>
          <div class="product-item" data-category="plus" data-subcategory="plus" data-price="1999">
            {% render 'product-card',
              title: 'ExtraLove Plum Cotton Straight Kurta Set (3XL-6XL)',
              price: '₹1,999',
              original_price: '₹3,999',
              image: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop'
            %}
          </div>
        {%- endif -%}
      </div>

      {% if paginate.pages > 1 %}
        <div class="flex items-center justify-center gap-2 pt-12">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {%- endpaginate -%}

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const chips = document.querySelectorAll('#collection-chips .subcat-chip');
    const items = document.querySelectorAll('#collection-grid .product-item');
    const countEl = document.getElementById('product-count');
    const sortSelect = document.getElementById('coll-sort');

    chips.forEach(chip => {
      chip.addEventListener('click', function () {
        const filter = this.getAttribute('data-filter-subcat');
        
        chips.forEach(c => {
          c.classList.remove('active', 'bg-[#71006A]', 'text-white');
          c.classList.add('bg-[#FAF7F9]', 'text-[#252525]');
        });
        this.classList.add('active', 'bg-[#71006A]', 'text-white');
        this.classList.remove('bg-[#FAF7F9]', 'text-[#252525]');

        let visibleCount = 0;
        items.forEach(item => {
          const sub = item.getAttribute('data-subcategory') || '';
          const cat = item.getAttribute('data-category') || '';
          if (filter === 'all' || sub === filter || cat === filter) {
            item.style.display = 'block';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (countEl) countEl.textContent = visibleCount;
      });
    });

    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        const grid = document.getElementById('collection-grid');
        const sortVal = this.value;
        const currentItems = Array.from(items);

        currentItems.sort((a, b) => {
          const priceA = parseInt(a.getAttribute('data-price') || '0');
          const priceB = parseInt(b.getAttribute('data-price') || '0');
          if (sortVal === 'price-low') return priceA - priceB;
          if (sortVal === 'price-high') return priceB - priceA;
          return 0;
        });

        currentItems.forEach(el => grid.appendChild(el));
      });
    }
  });
</script>

{% schema %}
{
  "name": "Main Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "label": "Products per Page",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable Subcategory Filter Chips",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable Sort Dropdown",
      "default": true
    }
  ]
}
{% endschema %}
