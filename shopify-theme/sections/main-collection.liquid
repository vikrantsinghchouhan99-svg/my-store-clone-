<div class="py-12 bg-white">
  <div class="container">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto space-y-2 mb-10">
      <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold">
        COLLECTION
      </span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#252525]">
        {{ collection.title | default: 'All Festive Collections' }}
      </h1>
      <p class="text-xs sm:text-sm text-[#737373]">
        {{ collection.description | default: 'Explore our hallmark Indian ethnic silhouettes crafted in comfortable fabrics and festive hand-embroidered finishes.' }}
      </p>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {% if collection.products_count > 0 %}
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% render 'product-card',
          title: 'Purple Zari Embroidered Silk Anarkali Suit Set',
          price: '₹3,499',
          original_price: '₹6,999',
          image: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop'
        %}
        {% render 'product-card',
          title: 'Mustard Gotta Patti Georgette Sharara Suit Set',
          price: '₹2,799',
          original_price: '₹5,599',
          image: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=600&auto=format&fit=crop'
        %}
        {% render 'product-card',
          title: 'Blush Pink Pure Cotton Straight Kurta Palazzo Set',
          price: '₹1,499',
          original_price: '₹2,999',
          image: 'https://images.unsplash.com/photo-1596783074918-c84cb06531ca?q=80&w=600&auto=format&fit=crop'
        %}
        {% render 'product-card',
          title: 'Emerald Green Embroidered Velvet Suit Set',
          price: '₹4,499',
          original_price: '₹8,999',
          image: 'https://images.unsplash.com/photo-1558769132-cb1aea458c5e?q=80&w=600&auto=format&fit=crop'
        %}
        {% render 'product-card',
          title: 'Wine Chanderi Silk Foil Print Straight Kurta',
          price: '₹1,299',
          original_price: '₹2,599',
          image: 'https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?q=80&w=600&auto=format&fit=crop'
        %}
        {% render 'product-card',
          title: 'Lavender Pure Organza Floral Zari Saree',
          price: '₹2,899',
          original_price: '₹5,799',
          image: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=600&auto=format&fit=crop'
        %}
        {% render 'product-card',
          title: 'Rust Red Tiered Georgette Maxi Ethnic Dress',
          price: '₹2,199',
          original_price: '₹4,399',
          image: 'https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?q=80&w=600&auto=format&fit=crop'
        %}
        {% render 'product-card',
          title: 'Maroon Festive Silk Blend Anarkali Set',
          price: '₹3,799',
          original_price: '₹7,599',
          image: 'https://images.unsplash.com/photo-1608256246200-53e635b5b65f?q=80&w=600&auto=format&fit=crop'
        %}
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}
