<script>
  document.addEventListener('DOMContentLoaded', function () {
    const chips = document.querySelectorAll('.subcat-chip');
    const items = document.querySelectorAll('#collection-grid .product-item');
    const countEl = document.getElementById('product-count');
    const sortSelect = document.getElementById('coll-sort');

    // Parse URL query parameter for category or filter
    const urlParams = new URLSearchParams(window.location.search);
    const filterParam = urlParams.get('filter') || urlParams.get('category');

    function applyFilter(target) {
      let visible = 0;
      chips.forEach(c => {
        if (c.getAttribute('data-filter-subcat') === target) {
          c.classList.add('active', 'bg-[#71006A]', 'text-white');
          c.classList.remove('bg-[#FAF7F9]', 'text-[#252525]', 'border');
        } else {
          c.classList.remove('active', 'bg-[#71006A]', 'text-white');
          c.classList.add('bg-[#FAF7F9]', 'text-[#252525]', 'border');
        }
      });

      items.forEach(item => {
        const cat = item.getAttribute('data-category');
        const subcat = item.getAttribute('data-subcategory');
        if (target === 'all' || subcat === target || cat === target) {
          item.classList.remove('hidden');
          visible++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (countEl) countEl.textContent = visible;
    }

    chips.forEach(chip => {
      chip.addEventListener('click', function () {
        const target = this.getAttribute('data-filter-subcat');
        applyFilter(target);
      });
    });

    if (filterParam) {
      applyFilter(filterParam.toLowerCase());
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        const grid = document.getElementById('collection-grid');
        const sortVal = this.value;
        const currentItems = Array.from(items);

        currentItems.sort((a, b) => {
          const priceA = parseInt(a.getAttribute('data-price') || '0');
          const priceB = parseInt(b.getAttribute('data-price') || '0');
          if (sortVal === 'price-low') return priceA - priceB;
          if (sortVal === 'price-high') return priceB - priceA;
          return 0;
        });

        currentItems.forEach(el => grid.appendChild(el));
      });
    }
  });
</script>

