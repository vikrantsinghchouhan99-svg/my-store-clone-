<div class="py-14 bg-white flex items-center justify-center min-h-[50vh]">
  <div class="container max-w-md p-6 bg-[#FAF7F9] border border-[#E6E6E6] rounded-2xl shadow-xs">
    <div class="text-center space-y-1 mb-6">
      <span class="text-[10px] font-mono tracking-widest uppercase text-[#71006A] font-extrabold">JOIN LIBAS</span>
      <h1 class="text-2xl font-serif font-bold text-[#252525]">Create Account</h1>
    </div>

    {% form 'create_customer' %}
      {{ form.errors | default_errors }}
      <div class="space-y-3">
        <div>
          <label class="text-xs font-bold text-[#252525] block mb-1">First Name</label>
          <input type="text" name="customer[first_name]" class="w-full px-3.5 py-2.5 rounded-lg bg-white border border-[#E6E6E6] text-xs outline-none">
        </div>
        <div>
          <label class="text-xs font-bold text-[#252525] block mb-1">Last Name</label>
          <input type="text" name="customer[last_name]" class="w-full px-3.5 py-2.5 rounded-lg bg-white border border-[#E6E6E6] text-xs outline-none">
        </div>
        <div>
          <label class="text-xs font-bold text-[#252525] block mb-1">Email Address *</label>
          <input type="email" name="customer[email]" required class="w-full px-3.5 py-2.5 rounded-lg bg-white border border-[#E6E6E6] text-xs outline-none">
        </div>
        <div>
          <label class="text-xs font-bold text-[#252525] block mb-1">Password *</label>
          <input type="password" name="customer[password]" required class="w-full px-3.5 py-2.5 rounded-lg bg-white border border-[#E6E6E6] text-xs outline-none">
        </div>
        <button type="submit" class="w-full py-3 rounded-lg bg-[#71006A] text-white text-xs font-bold uppercase tracking-wider hover:bg-[#560050] transition-colors shadow-md mt-2">
          Create Account
        </button>
      </div>
    {% endform %}

    <div class="text-center text-xs text-[#737373] mt-4 pt-4 border-t border-[#E6E6E6]">
      Already have an account? <a href="/account/login" class="text-[#71006A] font-bold hover:underline">Sign In</a>
    </div>
  </div>
</div>
