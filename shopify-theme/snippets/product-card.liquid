{% comment %}
  Renders a product card
  Accepts:
  - product: {Object} Product Liquid object (optional, falls back to mock)
  - title: {String}
  - price: {String}
  - original_price: {String}
  - image: {String}
  - url: {String}
{% endcomment %}

{% if product and product.title != blank %}
  {% assign card_title = product.title %}
  {% assign card_price = product.price | money %}
  {% assign card_orig_price = product.compare_at_price | money %}
  {% if product.featured_image %}
    {% assign card_image = product.featured_image | image_url: width: 600 %}
  {% else %}
    {% assign card_image = 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop' %}
  {% endif %}
  {% if product.images.size > 1 %}
    {% assign card_hover_image = product.images[1] | image_url: width: 600 %}
  {% else %}
    {% assign card_hover_image = card_image %}
  {% endif %}
  {% assign card_url = product.url %}
  {% assign card_vendor = product.vendor | default: 'LIBAS' %}

  {% if product.compare_at_price > product.price %}
    {% assign discount_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
    {% assign discount_label = discount_pct | append: '% OFF' %}
  {% else %}
    {% assign discount_label = 'BESTSELLER' %}
  {% endif %}
  {% assign variant_id = product.selected_or_first_available_variant.id %}
{% else %}
  {% assign card_title = title | default: 'Purple Zari Embroidered Silk Anarkali' %}
  {% assign card_price = price | default: '₹3,499' %}
  {% assign card_orig_price = original_price | default: '₹6,999' %}
  {% assign card_image = image | default: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop' %}
  {% assign card_hover_image = card_image %}
  {% assign card_url = url | default: '/products/silk-anarkali' %}
  {% assign card_vendor = 'LIBAS EDITORIAL' %}
  {% assign discount_label = '50% OFF' %}
  {% assign variant_id = '' %}
{% endif %}

<div class="product-card group rounded-xl overflow-hidden bg-white border border-[#E6E6E6] hover:border-[#71006A] transition-all">
  <div class="product-card-image relative aspect-[3/4] bg-[#F5F5F5] rounded-xl overflow-hidden">
    <a href="{{ card_url }}" class="block w-full h-full">
      <img
        src="{{ card_image }}"
        alt="{{ card_title | escape }}"
        loading="lazy"
        width="600"
        height="800"
        class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
        onerror="this.src='https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop';"
      >
    </a>

    <!-- Discount Badge -->
    <span class="product-badge absolute top-2 left-2 bg-[#71006A] text-white text-[9px] font-bold px-2 py-0.5 rounded uppercase tracking-wider shadow-xs">
      {{ discount_label }}
    </span>

    <!-- Wishlist Button -->
    <button
      type="button"
      class="wishlist-btn absolute top-2 right-2 p-1.5 rounded-full bg-white/90 hover:bg-white text-[#71006A] border-none cursor-pointer shadow-xs transition-colors z-10"
      data-wishlist-toggle
      data-product-title="{{ card_title | escape }}"
      aria-label="Add to Wishlist"
    >
      <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </button>

    <!-- Quick View / Quick Add Trigger -->
    <button
      type="button"
      class="quick-view-btn absolute bottom-3 left-3 right-3 py-2 bg-white/95 hover:bg-[#71006A] text-[#252525] hover:text-white text-xs font-bold uppercase tracking-wider rounded-lg shadow-md border-none cursor-pointer transition-all opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0"
      data-quick-view
      data-title="{{ card_title | escape }}"
      data-price="{{ card_price }}"
      data-original-price="{{ card_orig_price }}"
      data-image="{{ card_image }}"
      data-url="{{ card_url }}"
      data-variant-id="{{ variant_id }}"
    >
      Quick View
    </button>
  </div>

  <div class="p-3 text-left space-y-1">
    <span class="text-[9px] font-mono uppercase text-[#71006A] font-extrabold tracking-wider block truncate">
      {{ card_vendor }}
    </span>
    <h3 class="text-xs font-semibold text-[#252525] line-clamp-1 group-hover:text-[#71006A] transition-colors">
      <a href="{{ card_url }}" class="hover:underline">{{ card_title }}</a>
    </h3>
    <div class="flex items-baseline gap-2 pt-0.5">
      <span class="text-xs font-extrabold text-[#71006A]">{{ card_price }}</span>
      {% if card_orig_price != blank and card_orig_price != card_price %}
        <span class="text-[10px] text-[#999999] line-through">{{ card_orig_price }}</span>
      {% endif %}
      <span class="text-[10px] text-emerald-700 font-bold">{{ discount_label }}</span>
    </div>
  </div>
</div>
