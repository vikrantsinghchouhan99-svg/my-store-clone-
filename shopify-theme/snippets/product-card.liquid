{% comment %}
  Renders a product card
  Accepts:
  - product: {Object} Product Liquid object (optional, falls back to mock)
  - title: {String}
  - price: {String}
  - original_price: {String}
  - image: {String}
  - tag: {String}
{% endcomment %}

{% assign card_title = title | default: product.title | default: 'Purple Zari Embroidered Silk Anarkali' %}
{% assign card_price = price | default: product.price | money | default: '₹3,499' %}
{% assign card_orig_price = original_price | default: product.compare_at_price | money | default: '₹6,999' %}
{% assign card_image = image | default: product.featured_image | image_url: width: 600 | default: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop' %}

<div class="product-card group rounded-xl overflow-hidden">
  <div class="product-card-image relative aspect-[3/4] bg-[#F5F5F5] rounded-xl overflow-hidden">
    <a href="{{ product.url | default: '/products/silk-anarkali' }}">
      <img
        src="{{ card_image }}"
        alt="{{ card_title | escape }}"
        loading="lazy"
        width="600"
        height="800"
        onerror="this.src='https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=600&auto=format&fit=crop';"
      >
    </a>

    <span class="product-badge absolute top-2 left-2 bg-[#71006A] text-white text-[9px] font-bold px-2 py-0.5 rounded uppercase">
      50% OFF
    </span>

    <button
      type="button"
      class="quick-view-btn"
      data-quick-view
      data-title="{{ card_title | escape }}"
      data-price="{{ card_price }}"
      data-original-price="{{ card_orig_price }}"
      data-image="{{ card_image }}"
    >
      Quick View
    </button>
  </div>

  <div class="p-3 text-left space-y-1">
    <span class="text-[9px] font-mono uppercase text-[#71006A] font-extrabold tracking-wider">
      LIBAS EDITORIAL
    </span>
    <h3 class="text-xs font-semibold text-[#252525] line-clamp-1 group-hover:text-[#71006A] transition-colors">
      <a href="{{ product.url | default: '/products/silk-anarkali' }}">{{ card_title }}</a>
    </h3>
    <div class="flex items-baseline gap-2 pt-0.5">
      <span class="text-xs font-bold text-[#71006A]">{{ card_price }}</span>
      <span class="text-[10px] text-[#999999] line-through">{{ card_orig_price }}</span>
      <span class="text-[10px] text-emerald-700 font-bold">50% off</span>
    </div>
  </div>
</div>
